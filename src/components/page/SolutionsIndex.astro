---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../shared/SectionHeading.astro';
import CTAButton from '../shared/CTAButton.astro';
import { getSolutions } from '../../i18n/content';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const solutions = getSolutions(lang);

const solutionIcons: Record<string, string> = {
  marketing: '<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/></svg>',
  sales: '<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 17v5m-2.5 0h5"/></svg>',
  support: '<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>',
};
---

<PageLayout
  title={t('page.solutions.title')}
  description={t('page.solutions.description')}
  canonicalPath={Astro.url.pathname}
>
  <!-- Hero -->
  <section class="relative py-20 sm:py-28 bg-gradient-to-b from-green-50 to-white overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, #25D366 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block px-3 py-1 text-xs font-semibold text-wa-green bg-green-50 rounded-full uppercase tracking-wider mb-4">
          {t('breadcrumb.solutions')}
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 leading-tight mb-6">
          {t('solution.indexH1')}
        </h1>
        <p class="text-lg sm:text-xl text-gray-600 leading-relaxed mb-8">
          {t('solution.indexSub')}
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <CTAButton href={localizePath('/signup', lang)} size="lg">{t('cta.startTrial')}</CTAButton>
          <CTAButton href={localizePath('/pricing', lang)} variant="secondary" size="lg">{t('cta.viewPricing')}</CTAButton>
        </div>
      </div>
    </div>
  </section>

  <!-- Solutions Grid -->
  <section class="py-20 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {solutions.map((solution) => (
          <a href={localizePath(`/solutions/${solution.slug}`, lang)} class="group block bg-white rounded-2xl border border-gray-100 p-8 transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:border-wa-green/20">
            <div class="w-14 h-14 bg-green-50 rounded-xl flex items-center justify-center mb-5 text-wa-green group-hover:bg-wa-green group-hover:text-white transition-colors duration-200">
              <Fragment set:html={solutionIcons[solution.slug] ?? solutionIcons['support']} />
            </div>
            <p class="text-xs font-semibold text-wa-teal uppercase tracking-wider mb-2">{solution.title}</p>
            <h2 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-wa-green transition-colors">{solution.headline}</h2>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">{solution.description}</p>
            <div class="flex items-center gap-1 text-sm font-medium text-wa-green">
              {t('home.features.learnMore')}
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 sm:py-24 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">{t('industry.notSeeTitle')}</h2>
      <p class="text-lg text-gray-600 mb-8">{t('industry.notSeeBody')}</p>
      <div class="flex flex-wrap justify-center gap-4">
        <CTAButton href={localizePath('/signup', lang)} size="lg">{t('cta.startTrial')}</CTAButton>
        <CTAButton href={localizePath('/contact', lang)} variant="secondary" size="lg">{t('industry.talkToUs')}</CTAButton>
      </div>
    </div>
  </section>
</PageLayout>
