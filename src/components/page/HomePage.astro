---
import PageLayout from '../../layouts/PageLayout.astro';
import JsonLd from '../seo/JsonLd.astro';
import Hero from '../home/Hero.astro';
import Definition from '../home/Definition.astro';
import LogoCarousel from '../home/LogoCarousel.astro';
import VideoCarousel from '../home/VideoCarousel.astro';
import AICapabilities from '../home/AICapabilities.astro';
import BuyerJourney from '../home/BuyerJourney.astro';
import FeaturesGrid from '../home/FeaturesGrid.astro';
import Integrations from '../home/Integrations.astro';
import Stats from '../home/Stats.astro';
import Testimonials from '../home/Testimonials.astro';
import FinalCTA from '../home/FinalCTA.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { SITE } from '../../i18n/utils';
import layoutRaw from '../../data/home-layout.json';
import type { AstroComponentFactory } from 'astro';

// Section registry — the CMS (src/data/home-layout.json) controls order and
// visibility. Hero stays fixed at the top; unknown ids are skipped.
const SECTIONS: Record<string, AstroComponentFactory> = {
  definition: Definition,
  logos: LogoCarousel,
  videos: VideoCarousel,
  aiCapabilities: AICapabilities,
  buyerJourney: BuyerJourney,
  features: FeaturesGrid,
  integrations: Integrations,
  stats: Stats,
  testimonials: Testimonials,
  finalCta: FinalCTA,
};
type LayoutSection = { id: string; enabled?: boolean };
const layout = (layoutRaw as { sections?: LayoutSection[] }).sections ?? [];
const sections = layout.filter((s) => s.enabled !== false && SECTIONS[s.id]);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// SoftwareApplication on the root domain (GEO: LLMs parse product attributes
// here, not only /pricing) — same build-time plans API + no-rating convention
// as PricingPage's schema.
const PLAN_URLS = [
  'http://127.0.0.1:8000/api/public/plans',
  'https://waaichat.hsi.asia/api/public/plans',
];
let dbPlans: { name: string; price_monthly: number | null }[] = [];
for (const url of PLAN_URLS) {
  try {
    const res = await fetch(url);
    if (res.ok) {
      dbPlans = await res.json();
      break;
    }
  } catch {}
}
const starterMonthly = dbPlans.find((p) => p.name === 'starter')?.price_monthly ?? 2000;
const proMonthly = dbPlans.find((p) => p.name === 'pro')?.price_monthly ?? 9900;
const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'waai',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: t('page.home.description'),
  url: SITE,
  image: `${SITE}/images/og-default.jpg`,
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'SGD',
    lowPrice: starterMonthly / 100,
    highPrice: proMonthly / 100,
    offerCount: 2,
    url: `${SITE}/pricing/`,
  },
};
---

<PageLayout
  title={t('page.home.title')}
  description={t('page.home.description')}
  canonicalPath={Astro.url.pathname}
>
  <JsonLd data={softwareJsonLd} />
  <Hero />
  {sections.map((s) => {
    const Section = SECTIONS[s.id];
    return <Section />;
  })}
</PageLayout>
