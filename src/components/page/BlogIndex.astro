---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../shared/SectionHeading.astro';
import CTAButton from '../shared/CTAButton.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const categoryColor: Record<string, string> = {
  Guides: 'bg-green-50 text-green-700',
  Product: 'bg-blue-50 text-blue-700',
  Comparisons: 'bg-purple-50 text-ai-purple',
  Integrations: 'bg-yellow-50 text-yellow-700',
  Industry: 'bg-teal-50 text-wa-teal',
  News: 'bg-gray-100 text-gray-700',
};

// Published posts, newest first. Drafts (draft: true) are hidden.
const all = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const readTime = (body: string | undefined) => {
  const words = (body ?? '').trim().split(/\s+/).filter(Boolean).length;
  return `${Math.max(1, Math.round(words / 200))} min read`;
};

const featured = all[0];
const rest = all.slice(1);
---

<PageLayout title={t('page.blog.title')} description={t('page.blog.description')} canonicalPath={Astro.url.pathname}>
  <section class="py-20 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading title={t('blog.heading')} subtitle={t('blog.sub')} />

      {all.length === 0 ? (
        <p class="text-center text-gray-500 py-16">{t('blog.empty')}</p>
      ) : (
        <>
          {featured && (
            <a href={localizePath(`/blog/${featured.id}`, lang)} class="block mb-12 group">
              <div class="bg-gray-50 rounded-2xl border border-gray-200 p-8 sm:p-10 hover:border-gray-300 hover:shadow-md transition-all">
                <div class="flex items-center gap-3 mb-4">
                  <span class={`px-3 py-1 text-xs font-semibold rounded-full ${categoryColor[featured.data.category] ?? 'bg-gray-100 text-gray-700'}`}>{featured.data.category}</span>
                  <span class="text-sm text-gray-400">{fmt(featured.data.pubDate)}</span>
                  <span class="text-sm text-gray-400">{readTime(featured.body)}</span>
                </div>
                <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3 group-hover:text-wa-teal transition-colors">{featured.data.title}</h2>
                <p class="text-lg text-gray-600 leading-relaxed mb-4">{featured.data.description}</p>
                <span class="text-wa-green font-semibold text-sm group-hover:underline">{t('blog.readArticle')} &rarr;</span>
              </div>
            </a>
          )}

          <div class="grid sm:grid-cols-2 gap-8">
            {rest.map((post) => (
              <a href={localizePath(`/blog/${post.id}`, lang)} class="group bg-white rounded-2xl border border-gray-200 p-8 hover:border-gray-300 hover:shadow-md transition-all">
                <div class="flex items-center gap-3 mb-4">
                  <span class={`px-3 py-1 text-xs font-semibold rounded-full ${categoryColor[post.data.category] ?? 'bg-gray-100 text-gray-700'}`}>{post.data.category}</span>
                  <span class="text-sm text-gray-400">{fmt(post.data.pubDate)}</span>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-wa-teal transition-colors">{post.data.title}</h3>
                <p class="text-gray-600 text-sm leading-relaxed mb-4">{post.data.description}</p>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-gray-400">{readTime(post.body)}</span>
                  <span class="text-wa-green font-semibold text-sm group-hover:underline">{t('blog.readMore')} &rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </>
      )}

      <!-- Newsletter CTA -->
      <div class="mt-16 bg-gray-50 rounded-2xl border border-gray-200 p-8 sm:p-10 text-center">
        <h3 class="text-xl font-bold text-gray-900 mb-2">{t('blog.newsletterTitle')}</h3>
        <p class="text-gray-600 mb-6">{t('blog.newsletterBody')}</p>
        <CTAButton href={localizePath('/signup', lang)} size="md">{t('blog.cta')}</CTAButton>
      </div>
    </div>
  </section>
</PageLayout>
