---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../shared/SectionHeading.astro';
import SignupForm from '../signup/SignupForm.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<PageLayout title={t('page.signup.title')} description={t('page.signup.description')} canonicalPath={Astro.url.pathname}>
  <section class="py-16 sm:py-20 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading title={t('signup.heading')} subtitle={t('signup.sub')} />

      <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 sm:p-10">
        <SignupForm />
      </div>

      <p class="text-center text-sm text-gray-500 mt-6">
        {t('signup.alreadyHave')}
        <a href="https://waaichat.hsi.asia/login" class="text-wa-green font-semibold hover:underline">{t('signup.signIn')}</a>
      </p>
    </div>
  </section>
</PageLayout>
