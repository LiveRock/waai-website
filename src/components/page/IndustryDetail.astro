---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../shared/SectionHeading.astro';
import CTAButton from '../shared/CTAButton.astro';
import { getIndustry } from '../../i18n/content';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

interface Props { slug: string }
const { slug } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const industry = getIndustry(slug, lang);
const title = industry?.title ?? '';
const howTitle = t('industry.howTitle').replace('{title}', title);
const transformTitle = t('industry.transformTitle').replace('{title}', title);
---

<PageLayout title={`${title} — waai`} description={industry?.metaDescription ?? ''} canonicalPath={Astro.url.pathname}>
  <!-- Hero -->
  <section class="relative py-20 sm:py-28 bg-gradient-to-b from-green-50 to-white overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, #25D366 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="mb-8 text-sm text-gray-500">
        <a href={localizePath('/', lang)} class="hover:text-wa-green transition-colors">{t('breadcrumb.home')}</a>
        <span class="mx-2">/</span>
        <a href={localizePath('/industries', lang)} class="hover:text-wa-green transition-colors">{t('breadcrumb.industries')}</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900 font-medium">{title}</span>
      </nav>

      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 text-xs font-semibold text-wa-green bg-green-50 rounded-full uppercase tracking-wider mb-4">{title}</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 leading-tight mb-6">{industry?.headline}</h1>
        <p class="text-lg sm:text-xl text-gray-600 leading-relaxed mb-8">{industry?.description}</p>
        <div class="flex flex-wrap gap-4">
          <CTAButton href={localizePath('/signup', lang)} size="lg">{t('cta.startTrial')}</CTAButton>
          <CTAButton href={localizePath('/pricing', lang)} variant="secondary" size="lg">{t('cta.viewPricing')}</CTAButton>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="py-20 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading title={t('industry.painTitle')} subtitle={t('industry.painSub')} align="center" />
      <div class="max-w-3xl mx-auto space-y-4">
        {industry?.painPoints.map((point) => (
          <div class="flex items-start gap-4 bg-white rounded-2xl border border-gray-100 p-6 transition-all duration-200 hover:shadow-md">
            <div class="w-10 h-10 bg-red-50 rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <p class="text-gray-700 leading-relaxed pt-1.5">{point}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="py-20 sm:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading title={howTitle} subtitle={t('industry.howSub')} align="center" />
      <div class="grid md:grid-cols-3 gap-8">
        {industry?.useCases.map((useCase, index) => (
          <div class="bg-white rounded-2xl border border-gray-100 p-8 transition-all duration-200 hover:-translate-y-1 hover:shadow-lg">
            <div class="w-10 h-10 bg-green-50 rounded-lg flex items-center justify-center mb-5">
              <span class="text-wa-green font-bold text-lg">{index + 1}</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-3">{useCase.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{useCase.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 sm:py-24 bg-wa-teal">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{transformTitle}</h2>
      <p class="text-lg text-green-100 mb-8">{t('industry.transformBody')}</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={localizePath('/signup', lang)} class="inline-flex items-center justify-center font-semibold rounded-lg px-8 py-4 text-base bg-white text-wa-teal hover:bg-gray-100 transition-all duration-200 shadow-sm hover:shadow-md">{t('cta.startTrial')}</a>
        <a href={localizePath('/pricing', lang)} class="inline-flex items-center justify-center font-semibold rounded-lg px-8 py-4 text-base border-2 border-white text-white hover:bg-white hover:text-wa-teal transition-all duration-200">{t('common.seeAllPlans')}</a>
      </div>
    </div>
  </section>
</PageLayout>
