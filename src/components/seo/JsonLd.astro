---
/**
 * Emits a schema.org JSON-LD block. The `type` attribute keeps Astro from
 * bundling the script; set:html injects the serialized object verbatim.
 */
interface Props {
  /** Schema.org node (include '@context' yourself for standalone nodes). */
  data: Record<string, unknown>;
}
const { data } = Astro.props;
---
<script type="application/ld+json" set:html={JSON.stringify(data)} />
