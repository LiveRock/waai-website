---
import { footerLinks, type NavItem } from '../../data/navigation';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';
import type { Translator } from '../../i18n/utils';

interface Props {
  lang?: Lang;
  t?: Translator;
}
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = Astro.props.t ?? useTranslations(lang);

const label = (item: NavItem) => (item.key ? t(item.key) : item.label ?? '');
const link = (href?: string) => (href ? localizePath(href, lang) : '#');
const columns: { heading: string; items: NavItem[] }[] = [
  { heading: t('footer.col.product'), items: footerLinks.product },
  { heading: t('footer.col.solutions'), items: footerLinks.solutions },
  { heading: t('footer.col.integrations'), items: footerLinks.integrations },
  { heading: t('footer.col.resources'), items: footerLinks.resources },
];
const year = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 lg:gap-12">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-3 lg:col-span-1">
        <a href={localizePath('/', lang)} class="flex items-center gap-2 mb-4">
          <img src="/images/logos/logo.jpg" alt="waai.me" class="w-8 h-8 rounded-lg" />
          <span class="text-xl font-bold text-white">waai<span class="text-wa-green">.me</span></span>
        </a>
        <p class="text-sm text-gray-400 mb-4">{t('footer.tagline')}</p>
        <!-- Official Meta Tech Provider lockup (matches the hero pill; universal EN label) -->
        <div class="inline-flex items-center gap-2 mb-4">
          <svg class="w-4 h-4 shrink-0 text-gray-300" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.915 4.03c-1.968 0-3.683 1.28-4.871 3.113C.704 9.208 0 11.883 0 14.449c0 .706.07 1.369.21 1.973a6.624 6.624 0 0 0 .265.86 5.297 5.297 0 0 0 .371.761c.696 1.159 1.818 1.927 3.593 1.927 1.497 0 2.633-.671 3.965-2.444.76-1.012 1.144-1.626 2.663-4.32l.756-1.339.186-.325c.061.1.121.196.183.3l2.152 3.595c.724 1.21 1.665 2.556 2.47 3.314 1.046.987 1.992 1.22 3.06 1.22 1.075 0 1.876-.355 2.455-.843a3.743 3.743 0 0 0 .81-.973c.542-.939.861-2.127.861-3.745 0-2.72-.681-5.357-2.084-7.45-1.282-1.912-2.957-2.93-4.716-2.93-1.047 0-2.088.467-3.053 1.308-.652.57-1.257 1.29-1.82 2.05-.69-.875-1.335-1.547-1.958-2.056-1.182-.966-2.315-1.303-3.454-1.303zm10.16 2.053c1.147 0 2.188.758 2.992 1.999 1.132 1.748 1.647 4.195 1.647 6.4 0 1.548-.368 2.9-1.839 2.9-.58 0-1.027-.23-1.664-1.004-.496-.601-1.343-1.878-2.832-4.358l-.617-1.028a44.908 44.908 0 0 0-1.255-1.98c.07-.109.141-.224.211-.327 1.12-1.667 2.118-2.602 3.358-2.602zm-10.201.553c1.265 0 2.058.791 2.675 1.446.307.327.737.871 1.234 1.579l-1.02 1.566c-.757 1.163-1.882 3.017-2.837 4.338-1.191 1.649-1.81 1.817-2.486 1.817-.524 0-1.038-.237-1.383-.794-.263-.426-.464-1.13-.464-2.046 0-2.221.63-4.535 1.66-6.088.454-.687.964-1.226 1.533-1.533a2.264 2.264 0 0 1 1.088-.285z"/></svg>
          <span class="text-xs text-gray-400">{t('meta.techProvider')}</span>
        </div>
        <p class="text-sm text-gray-500 mb-3">{t('footer.productOf')}</p>
        <p class="text-xs text-gray-500 mb-2">{t('footer.getTheApp')}</p>
        <div class="flex items-center gap-2">
          <a href="https://apps.apple.com/sg/app/waai-assistant/id6766452095" target="_blank" rel="noopener noreferrer" aria-label="Download on the App Store">
            <img src="/images/icons/appstore-download.png" alt="Download on the App Store" class="h-8 w-auto" loading="lazy" />
          </a>
          <a href="https://play.google.com/store/apps/details?id=net.hotsource.waai" target="_blank" rel="noopener noreferrer" aria-label="Get it on Google Play">
            <img src="/images/icons/googleplay-getiton.png" alt="Get it on Google Play" class="h-8 w-auto" loading="lazy" />
          </a>
        </div>
        <!-- Social links (brand names are universal — no i18n needed; icons via simple-icons like the Meta badge) -->
        <div class="flex items-center gap-4 mt-6">
          <a href="https://www.facebook.com/waai.smart.assistant" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-gray-400 hover:text-wa-green transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.instagram.com/waai.me/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-gray-400 hover:text-wa-green transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"/></svg>
          </a>
          <a href="https://www.youtube.com/@waai-me" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-gray-400 hover:text-wa-green transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="https://www.tiktok.com/@peterwaailum" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="text-gray-400 hover:text-wa-green transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
          </a>
        </div>
      </div>

      {columns.map((col) => (
        <div>
          <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">{col.heading}</h4>
          <ul class="space-y-2.5">
            {col.items.map((item) => (
              <li><a href={link(item.href)} class="text-sm text-gray-400 hover:text-wa-green transition-colors">{label(item)}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-gray-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-gray-500">&copy; {year} waai.me. {t('footer.rights')}</p>
      <div class="flex items-center gap-6">
        {footerLinks.legal.map((item) => (
          <a href={link(item.href)} class="text-sm text-gray-500 hover:text-gray-300 transition-colors">{label(item)}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
