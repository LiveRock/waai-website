---
import { footerLinks, type NavItem } from '../../data/navigation';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';
import type { Translator } from '../../i18n/utils';

interface Props {
  lang?: Lang;
  t?: Translator;
}
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = Astro.props.t ?? useTranslations(lang);

const label = (item: NavItem) => (item.key ? t(item.key) : item.label ?? '');
const link = (href?: string) => (href ? localizePath(href, lang) : '#');
const columns: { heading: string; items: NavItem[] }[] = [
  { heading: t('footer.col.product'), items: footerLinks.product },
  { heading: t('footer.col.solutions'), items: footerLinks.solutions },
  { heading: t('footer.col.integrations'), items: footerLinks.integrations },
  { heading: t('footer.col.resources'), items: footerLinks.resources },
];
const year = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 lg:gap-12">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-3 lg:col-span-1">
        <a href={localizePath('/', lang)} class="flex items-center gap-2 mb-4">
          <img src="/images/logos/logo.jpg" alt="waai.me" class="w-8 h-8 rounded-lg" />
          <span class="text-xl font-bold text-white">waai<span class="text-wa-green">.me</span></span>
        </a>
        <p class="text-sm text-gray-400 mb-4">{t('footer.tagline')}</p>
        <p class="text-sm text-gray-500 mb-3">{t('footer.productOf')}</p>
        <p class="text-xs text-gray-500 mb-2">{t('footer.getTheApp')}</p>
        <div class="flex items-center gap-2">
          <a href="https://apps.apple.com/sg/app/waai-assistant/id6766452095" target="_blank" rel="noopener noreferrer" aria-label="Download on the App Store">
            <img src="/images/icons/app-store.jpg" alt="Download on the App Store" class="h-8 w-auto rounded" loading="lazy" />
          </a>
          <a href="https://play.google.com/store/apps/details?id=net.hotsource.waai" target="_blank" rel="noopener noreferrer" aria-label="Get it on Google Play">
            <img src="/images/icons/google-play.jpg" alt="Get it on Google Play" class="h-8 w-auto rounded" loading="lazy" />
          </a>
        </div>
      </div>

      {columns.map((col) => (
        <div>
          <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">{col.heading}</h4>
          <ul class="space-y-2.5">
            {col.items.map((item) => (
              <li><a href={link(item.href)} class="text-sm text-gray-400 hover:text-wa-green transition-colors">{label(item)}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-gray-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-gray-500">&copy; {year} waai.me. {t('footer.rights')}</p>
      <div class="flex items-center gap-6">
        {footerLinks.legal.map((item) => (
          <a href={link(item.href)} class="text-sm text-gray-500 hover:text-gray-300 transition-colors">{label(item)}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
