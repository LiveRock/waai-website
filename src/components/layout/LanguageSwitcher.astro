---
import { LOCALES, LANGS, type Lang } from '../../i18n/config';
import { getLocalizedPath, type Translator } from '../../i18n/utils';

interface Props {
  lang: Lang;
  t: Translator;
  variant?: 'desktop' | 'mobile';
}

const { lang, t, variant = 'desktop' } = Astro.props;
const currentPath = Astro.url.pathname;
const current = LOCALES[lang];
---

{
  variant === 'desktop' ? (
    <div class="relative group">
      <button
        class="flex items-center gap-1 px-2.5 py-2 text-sm font-medium text-gray-700 hover:text-wa-green transition-colors rounded-lg hover:bg-gray-50"
        aria-label={t('lang.switcherAria')}
        aria-haspopup="true"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"
          />
        </svg>
        <span>{current.label}</span>
        <svg class="w-3 h-3 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div class="absolute right-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
        <div class="bg-white rounded-xl shadow-lg border border-gray-100 py-2 min-w-44">
          {LANGS.map((code) => (
            <a
              href={getLocalizedPath(currentPath, code)}
              class:list={[
                'block px-4 py-2 text-sm transition-colors',
                code === lang ? 'text-wa-green bg-green-50 font-medium' : 'text-gray-700 hover:text-wa-green hover:bg-green-50',
              ]}
              aria-current={code === lang ? 'true' : undefined}
              lang={LOCALES[code].htmlLang}
            >
              {LOCALES[code].label}
            </a>
          ))}
        </div>
      </div>
    </div>
  ) : (
    <div class="px-1 py-2">
      <div class="text-xs uppercase tracking-wider text-gray-400 mb-2 px-2">{t('lang.switcherLabel')}</div>
      <div class="grid grid-cols-2 gap-1.5">
        {LANGS.map((code) => (
          <a
            href={getLocalizedPath(currentPath, code)}
            class:list={[
              'block px-3 py-2 text-sm rounded-lg transition-colors text-center',
              code === lang ? 'text-wa-green bg-green-50 font-medium' : 'text-gray-700 hover:bg-gray-50',
            ]}
            aria-current={code === lang ? 'true' : undefined}
            lang={LOCALES[code].htmlLang}
          >
            {LOCALES[code].label}
          </a>
        ))}
      </div>
    </div>
  )
}
