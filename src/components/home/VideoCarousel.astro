---
import { getVideos } from '../../i18n/content';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  /** Override the section heading (defaults to the homepage "why not?"). */
  heading?: string;
}
const { heading } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const videos = getVideos(lang);
const headingText = heading ?? t('home.video.heading');
---

<section class="py-16 sm:py-20 bg-gray-50">
  <!-- Heading (constrained to site width) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-wa-green-dark text-center mb-10 sm:mb-12">{headingText}</h2>
  </div>

  <!-- Full-bleed carousel: the active video spans the browser width -->
  <div data-video-carousel>
    <div class="relative">
      <div data-carousel-track
        class="no-scrollbar flex overflow-x-auto overscroll-x-contain snap-x snap-mandatory scroll-smooth">
        {videos.map((v, i) => (
          <article data-card tabindex="-1"
            class="snap-start shrink-0 w-screen px-4 sm:px-6 lg:px-8">
            <div class="group relative aspect-video w-full rounded-2xl overflow-hidden shadow-md ring-1 ring-gray-200 bg-gray-900">
              <img
                src={`https://img.youtube.com/vi/${v.id}/maxresdefault.jpg`}
                alt={v.title}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                class="absolute inset-0 w-full h-full object-cover"
                onerror={`this.onerror=null;this.src='https://img.youtube.com/vi/${v.id}/hqdefault.jpg';`}
              />
              <!-- Click-to-play facade -->
              <button type="button" data-play data-video-id={v.id} data-title={v.title}
                aria-label={`${t('home.video.play')}: ${v.title}`}
                class="absolute inset-0 flex items-center justify-center bg-black/10 group-hover:bg-black/20 transition-colors cursor-pointer">
                <span class="flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-red-600 shadow-xl ring-4 ring-white/40 group-hover:scale-110 group-active:scale-95 transition-transform">
                  <svg class="w-7 h-7 sm:w-9 sm:h-9 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                </span>
              </button>
            </div>
            <h3 class="mt-4 text-center text-base sm:text-lg font-semibold text-gray-900 line-clamp-2">{v.title}</h3>
          </article>
        ))}
      </div>

      <!-- Prev / Next arrows (overlay the video edges; hidden on mobile where swipe is used) -->
      <button type="button" data-carousel-prev aria-label={t('home.video.prev')}
        class="hidden sm:flex absolute left-4 sm:left-6 lg:left-8 top-1/2 -translate-y-1/2 z-10 w-11 h-11 items-center justify-center rounded-full bg-white/95 backdrop-blur shadow-lg ring-1 ring-black/5 text-wa-teal hover:bg-white hover:scale-105 active:scale-95 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button type="button" data-carousel-next aria-label={t('home.video.next')}
        class="hidden sm:flex absolute right-4 sm:right-6 lg:right-8 top-1/2 -translate-y-1/2 z-10 w-11 h-11 items-center justify-center rounded-full bg-white/95 backdrop-blur shadow-lg ring-1 ring-black/5 text-wa-teal hover:bg-white hover:scale-105 active:scale-95 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>

    <!-- Dot indicators -->
    <div class="mt-6 flex items-center justify-center gap-1">
      {videos.map((v, i) => (
        <button type="button" data-dot={i} aria-label={`${i + 1} / ${videos.length}`}
          class="p-1.5 cursor-pointer rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-wa-teal/40">
          <span class="dot block rounded-full bg-gray-300 transition-all duration-200"></span>
        </button>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  .dot { width: 0.5rem; height: 0.5rem; }
  [data-active] .dot { width: 1.5rem; background-color: var(--color-wa-teal); }
</style>

<script is:inline>
  (function () {
    function init() {
      var root = document.querySelector('[data-video-carousel]');
      if (!root) return;

      var track = root.querySelector('[data-carousel-track]');
      var prevBtn = root.querySelector('[data-carousel-prev]');
      var nextBtn = root.querySelector('[data-carousel-next]');
      var dotEls = Array.prototype.slice.call(root.querySelectorAll('[data-dot]'));
      var cards = Array.prototype.slice.call(track.querySelectorAll('[data-card]'));
      if (!track || cards.length === 0) return;

      // One full-width card fills the viewport, so advance by the track's visible width.
      function cardStep() {
        if (cards.length < 2) return track.clientWidth;
        return cards[1].offsetLeft - cards[0].offsetLeft;
      }
      function step(dir) {
        track.scrollBy({ left: dir * Math.round(cardStep()), behavior: 'smooth' });
      }
      if (prevBtn) prevBtn.addEventListener('click', function () { step(-1); });
      if (nextBtn) nextBtn.addEventListener('click', function () { step(1); });

      // Click-to-play: replace thumbnail facade with a lazy YouTube iframe.
      root.querySelectorAll('[data-play]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-video-id');
          var title = btn.getAttribute('data-title') || 'YouTube video';
          var frame = btn.parentElement;
          var iframe = document.createElement('iframe');
          iframe.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0&modestbranding=1';
          iframe.title = title;
          iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
          iframe.setAttribute('allowfullscreen', '');
          iframe.setAttribute('loading', 'lazy');
          iframe.className = 'absolute inset-0 w-full h-full';
          frame.innerHTML = '';
          frame.appendChild(iframe);
        });
      });

      // Active-dot tracking (rAF-throttled) + click-to-jump.
      var raf = null;
      function updateDots() {
        raf = null;
        var trackLeft = track.getBoundingClientRect().left;
        var best = 0;
        var bestDist = Infinity;
        cards.forEach(function (card, i) {
          var d = Math.abs(card.getBoundingClientRect().left - trackLeft);
          if (d < bestDist) { bestDist = d; best = i; }
        });
        dotEls.forEach(function (dot, i) {
          if (i === best) dot.setAttribute('data-active', '');
          else dot.removeAttribute('data-active');
        });
      }
      track.addEventListener('scroll', function () {
        if (raf) return;
        raf = requestAnimationFrame(updateDots);
      });
      dotEls.forEach(function (dot, i) {
        dot.addEventListener('click', function () {
          var offset = cards[i].getBoundingClientRect().left - track.getBoundingClientRect().left;
          track.scrollBy({ left: offset, behavior: 'smooth' });
        });
      });

      // Keyboard a11y (arrow keys when focused inside the carousel).
      root.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
      });

      window.addEventListener('resize', updateDots);
      updateDots();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
