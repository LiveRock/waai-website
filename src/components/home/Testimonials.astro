---
import SectionHeading from '../shared/SectionHeading.astro';
import { testimonials } from '../../data/testimonials';
---

<section class="py-20 sm:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Businesses Love Their AI Agent"
      subtitle="See why companies choose waai.me to automate their WhatsApp customer conversations."
      badge="Testimonials"
    />

    <div class="grid md:grid-cols-3 gap-8">
      {testimonials.map((t) => (
        <div class="bg-white rounded-2xl border border-gray-100 p-6 sm:p-8 shadow-sm hover:shadow-md transition-shadow">
          <!-- Stars -->
          <div class="flex gap-1 mb-4">
            {[1,2,3,4,5].map(() => (
              <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <blockquote class="text-gray-700 leading-relaxed mb-6">"{t.quote}"</blockquote>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-gradient-to-br from-wa-green to-wa-teal rounded-full flex items-center justify-center text-white font-bold text-sm">
              {t.name.charAt(0)}
            </div>
            <div>
              <div class="font-medium text-gray-900 text-sm">{t.name}</div>
              <div class="text-xs text-gray-500">{t.role}, {t.company}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
