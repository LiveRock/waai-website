---
import SectionHeading from '../shared/SectionHeading.astro';
---

<section class="py-20 sm:py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Connect With the Tools You Already Use"
      subtitle="Google Workspace integration and AI Super Powers — your WhatsApp agent extends into your entire workflow."
      badge="Integrations"
    />

    <!-- Google Workspace -->
    <div class="mb-12">
      <h3 class="text-lg font-semibold text-gray-900 mb-6 text-center">Google Workspace</h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl border border-gray-100 p-6 text-center hover:shadow-md transition-shadow">
          <div class="w-12 h-12 mx-auto mb-3 bg-blue-50 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <div class="font-medium text-gray-900 text-sm">Google Calendar</div>
          <div class="text-xs text-gray-500 mt-1">Book appointments</div>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 p-6 text-center hover:shadow-md transition-shadow">
          <div class="w-12 h-12 mx-auto mb-3 bg-green-50 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
          </div>
          <div class="font-medium text-gray-900 text-sm">Google Drive</div>
          <div class="text-xs text-gray-500 mt-1">Upload & share files</div>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 p-6 text-center hover:shadow-md transition-shadow">
          <div class="w-12 h-12 mx-auto mb-3 bg-blue-50 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <div class="font-medium text-gray-900 text-sm">Google Docs</div>
          <div class="text-xs text-gray-500 mt-1">Create documents</div>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 p-6 text-center hover:shadow-md transition-shadow">
          <div class="w-12 h-12 mx-auto mb-3 bg-green-50 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          </div>
          <div class="font-medium text-gray-900 text-sm">Google Sheets</div>
          <div class="text-xs text-gray-500 mt-1">Spreadsheets from data</div>
        </div>
      </div>
    </div>

    <!-- Super Powers -->
    <div>
      <h3 class="text-lg font-semibold text-gray-900 mb-6 text-center">AI Super Powers <span class="text-xs text-ai-purple font-normal ml-1">Pro & Custom</span></h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl border border-gray-100 p-6 text-center hover:shadow-md transition-shadow">
          <div class="w-12 h-12 mx-auto mb-3 bg-purple-50 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-ai-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <div class="font-medium text-gray-900 text-sm">Vision</div>
          <div class="text-xs text-gray-500 mt-1">Image analysis & OCR</div>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 p-6 text-center hover:shadow-md transition-shadow">
          <div class="w-12 h-12 mx-auto mb-3 bg-blue-50 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-ai-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
          <div class="font-medium text-gray-900 text-sm">Web Search</div>
          <div class="text-xs text-gray-500 mt-1">Real-time info lookup</div>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 p-6 text-center hover:shadow-md transition-shadow">
          <div class="w-12 h-12 mx-auto mb-3 bg-teal-50 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          </div>
          <div class="font-medium text-gray-900 text-sm">Web Reader</div>
          <div class="text-xs text-gray-500 mt-1">Extract web content</div>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 p-6 text-center hover:shadow-md transition-shadow">
          <div class="w-12 h-12 mx-auto mb-3 bg-amber-50 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          </div>
          <div class="font-medium text-gray-900 text-sm">Zread</div>
          <div class="text-xs text-gray-500 mt-1">GitHub docs reader</div>
        </div>
      </div>
    </div>
  </div>
</section>
