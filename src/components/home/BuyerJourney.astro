---
import SectionHeading from '../shared/SectionHeading.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const panels = [
  {
    tab: 'marketing',
    tabLabel: t('nav.solution.marketing'),
    heading: t('home.journey.m.heading'),
    body: t('home.journey.m.body'),
    stats: [
      { value: '3x', label: t('home.journey.m.stat1') },
      { value: '98%', label: t('home.journey.m.stat2') },
      { value: '24/7', label: t('home.journey.m.stat3') },
    ],
    flowTitle: t('home.journey.m.flowTitle'),
    steps: [
      t('home.journey.m.s1'), t('home.journey.m.s2'),
      t('home.journey.m.s3'), t('home.journey.m.s4'),
    ],
    iconBg: 'bg-green-50', iconColor: 'text-wa-green',
    iconPath: 'M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.001 3.001 0 01-1.564-.317z',
    active: true,
  },
  {
    tab: 'sales',
    tabLabel: t('nav.solution.sales'),
    heading: t('home.journey.s.heading'),
    body: t('home.journey.s.body'),
    stats: [
      { value: '30%', label: t('home.journey.s.stat1') },
      { value: '3x', label: t('home.journey.s.stat2') },
      { value: '24/7', label: t('home.journey.s.stat3') },
    ],
    flowTitle: t('home.journey.s.flowTitle'),
    steps: [
      t('home.journey.s.s1'), t('home.journey.s.s2'),
      t('home.journey.s.s3'), t('home.journey.s.s4'),
    ],
    iconBg: 'bg-blue-50', iconColor: 'text-ai-blue',
    iconPath: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    tab: 'support',
    tabLabel: t('nav.solution.support'),
    heading: t('home.journey.u.heading'),
    body: t('home.journey.u.body'),
    stats: [
      { value: '80%', label: t('home.journey.u.stat1') },
      { value: '40%', label: t('home.journey.u.stat2') },
      { value: '<1s', label: t('home.journey.u.stat3') },
    ],
    flowTitle: t('home.journey.u.flowTitle'),
    steps: [
      t('home.journey.u.s1'), t('home.journey.u.s2'),
      t('home.journey.u.s3'), t('home.journey.u.s4'),
    ],
    iconBg: 'bg-orange-50', iconColor: 'text-orange-500',
    iconPath: 'M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z',
  },
];
---

<section class="py-20 sm:py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title={t('home.journey.title')}
      subtitle={t('home.journey.subtitle')}
    />

    <!-- Tabs -->
    <div class="flex justify-center mb-12">
      <div class="inline-flex bg-white rounded-xl border border-gray-200 p-1.5 gap-1">
        {panels.map((p, i) => (
          <button class:list={['buyer-tab px-5 py-2.5 text-sm font-semibold rounded-lg transition-all', i === 0 ? 'active bg-wa-green text-white' : 'text-gray-500 hover:text-gray-700']} data-tab={p.tab}>
            {p.tabLabel}
          </button>
        ))}
      </div>
    </div>

    {panels.map((p) => (
      <div class:list={['buyer-panel', !p.active && 'hidden']} id={`panel-${p.tab}`}>
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">{p.heading}</h3>
            <p class="text-gray-600 leading-relaxed mb-6">{p.body}</p>
            <div class="grid grid-cols-3 gap-6">
              {p.stats.map((s) => (
                <div>
                  <div class="text-3xl font-extrabold text-wa-green">{s.value}</div>
                  <div class="text-sm text-gray-500 mt-1">{s.label}</div>
                </div>
              ))}
            </div>
          </div>
          <div class="bg-white rounded-2xl border border-gray-100 p-8 shadow-sm">
            <div class="flex items-center gap-3 mb-6">
              <div class:list={['w-10 h-10 rounded-lg flex items-center justify-center', p.iconBg]}>
                <svg class:list={['w-5 h-5', p.iconColor]} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={p.iconPath}/></svg>
              </div>
              <h4 class="font-semibold text-gray-900">{p.flowTitle}</h4>
            </div>
            <div class="space-y-3">
              {p.steps.map((step, i) => (
                <Fragment>
                  <div class="flex items-center gap-3 text-sm">
                    <div class:list={['w-8 h-8 text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0', i === p.steps.length - 1 ? 'bg-ai-purple' : 'bg-wa-green']}>{i + 1}</div>
                    <span class="text-gray-600">{step}</span>
                  </div>
                  {i < p.steps.length - 1 && <div class="w-px h-4 bg-gray-200 ml-4"></div>}
                </Fragment>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const tabs = document.querySelectorAll('.buyer-tab');
  const panels = document.querySelectorAll('.buyer-panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');

      tabs.forEach((t) => {
        t.classList.remove('active', 'bg-wa-green', 'text-white');
        t.classList.add('text-gray-500');
      });
      tab.classList.add('active', 'bg-wa-green', 'text-white');
      tab.classList.remove('text-gray-500');

      panels.forEach((p) => p.classList.add('hidden'));
      document.getElementById(`panel-${target}`)?.classList.remove('hidden');
    });
  });
</script>
