---
import SectionHeading from '../shared/SectionHeading.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const panels = [
  {
    tab: 'marketing',
    tabLabel: t('nav.solution.marketing'),
    heading: t('home.journey.m.heading'),
    body: t('home.journey.m.body'),
    stats: [
      { value: '3x', label: t('home.journey.m.stat1') },
      { value: '98%', label: t('home.journey.m.stat2') },
      { value: '24/7', label: t('home.journey.m.stat3') },
    ],
    flowTitle: t('home.journey.m.flowTitle'),
    steps: [
      t('home.journey.m.s1'), t('home.journey.m.s2'),
      t('home.journey.m.s3'), t('home.journey.m.s4'),
    ],
    iconBg: 'bg-green-50', iconColor: 'text-wa-green',
    iconPath: 'M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.001 3.001 0 01-1.564-.317z',
    active: true,
  },
  {
    tab: 'sales',
    tabLabel: t('nav.solution.sales'),
    heading: t('home.journey.s.heading'),
    body: t('home.journey.s.body'),
    stats: [
      { value: '30%', label: t('home.journey.s.stat1') },
      { value: '3x', label: t('home.journey.s.stat2') },
      { value: '24/7', label: t('home.journey.s.stat3') },
    ],
    flowTitle: t('home.journey.s.flowTitle'),
    steps: [
      t('home.journey.s.s1'), t('home.journey.s.s2'),
      t('home.journey.s.s3'), t('home.journey.s.s4'),
    ],
    iconBg: 'bg-blue-50', iconColor: 'text-ai-blue',
    iconPath: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    tab: 'support',
    tabLabel: t('nav.solution.support'),
    heading: t('home.journey.u.heading'),
    body: t('home.journey.u.body'),
    stats: [
      { value: '80%', label: t('home.journey.u.stat1') },
      { value: '40%', label: t('home.journey.u.stat2') },
      { value: '<1s', label: t('home.journey.u.stat3') },
    ],
    flowTitle: t('home.journey.u.flowTitle'),
    steps: [
      t('home.journey.u.s1'), t('home.journey.u.s2'),
      t('home.journey.u.s3'), t('home.journey.u.s4'),
    ],
    iconBg: 'bg-orange-50', iconColor: 'text-orange-500',
    iconPath: 'M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z',
  },
];
---

<section class="py-20 sm:py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-12">
      <SectionHeading
        title={t('home.journey.title')}
        subtitle={t('home.journey.subtitle')}
        align="left"
      />
      <!-- Phone mockup (hero's frame at ~90%) playing another waai Short.
           lg:mb-12 mirrors SectionHeading's baked-in bottom margin so both
           columns optically centre on the same line. -->
      <div class="flex justify-center lg:mb-12">
        <div class="relative">
          <div class="w-[260px] h-[525px] bg-gray-900 rounded-[3.25rem] p-3 shadow-2xl">
            <div class="relative w-full h-full bg-black rounded-[2.6rem] overflow-hidden">
              <!-- waai promo Short, self-hosted (muted loop; script below gates playback) -->
              <video
                data-journey-video
                src="/videos/journey-waai-short.mp4"
                poster="/videos/journey-waai-short.jpg"
                muted
                loop
                playsinline
                preload="metadata"
                disablepictureinpicture
                class="w-full h-full object-cover"
                aria-label="waai — every WhatsApp conversation counts"
              ></video>
              <!-- Mobile tap-to-play overlay (desktop autoplays muted instead) -->
              <button
                type="button"
                data-journey-play
                aria-label={t('home.hero.video.play')}
                class="lg:hidden absolute inset-0 z-10 flex items-center justify-center bg-black/20 cursor-pointer group"
              >
                <span class="flex items-center justify-center w-16 h-16 rounded-full bg-wa-green shadow-xl ring-4 ring-white/40 group-hover:scale-110 group-active:scale-95 transition-transform">
                  <svg class="w-7 h-7 text-white ml-1" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                </span>
              </button>
              <!-- Sound toggle (video autoplays muted) -->
              <button
                type="button"
                data-journey-sound
                data-label-on={t('home.hero.video.soundOn')}
                data-label-off={t('home.hero.video.soundOff')}
                aria-pressed="false"
                aria-label={t('home.hero.video.soundOn')}
                class="absolute bottom-3 right-3 z-10 flex items-center justify-center w-10 h-10 rounded-full bg-black/50 backdrop-blur-sm text-white/90 shadow-lg ring-1 ring-white/25 hover:bg-black/65 hover:scale-105 active:scale-95 transition cursor-pointer"
              >
                <svg data-icon-muted class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
                <svg data-icon-on class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabs -->
    <div class="flex justify-center mt-12 lg:mt-0 mb-12">
      <div class="inline-flex bg-white rounded-xl border border-gray-200 p-1.5 gap-1">
        {panels.map((p, i) => (
          <button class:list={['buyer-tab px-5 py-2.5 text-sm font-semibold rounded-lg transition-all', i === 0 ? 'active bg-wa-green text-white' : 'text-gray-500 hover:text-gray-700']} data-tab={p.tab}>
            {p.tabLabel}
          </button>
        ))}
      </div>
    </div>

    {panels.map((p) => (
      <div class:list={['buyer-panel', !p.active && 'hidden']} id={`panel-${p.tab}`}>
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">{p.heading}</h3>
            <p class="text-gray-600 leading-relaxed mb-6">{p.body}</p>
            <div class="grid grid-cols-3 gap-6">
              {p.stats.map((s) => (
                <div>
                  <div class="text-3xl font-extrabold text-wa-green">{s.value}</div>
                  <div class="text-sm text-gray-500 mt-1">{s.label}</div>
                </div>
              ))}
            </div>
          </div>
          <div class="bg-white rounded-2xl border border-gray-100 p-8 shadow-sm">
            <div class="flex items-center gap-3 mb-6">
              <div class:list={['w-10 h-10 rounded-lg flex items-center justify-center', p.iconBg]}>
                <svg class:list={['w-5 h-5', p.iconColor]} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={p.iconPath}/></svg>
              </div>
              <h4 class="font-semibold text-gray-900">{p.flowTitle}</h4>
            </div>
            <div class="space-y-3">
              {p.steps.map((step, i) => (
                <Fragment>
                  <div class="flex items-center gap-3 text-sm">
                    <div class:list={['w-8 h-8 text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0', i === p.steps.length - 1 ? 'bg-ai-purple' : 'bg-wa-green']}>{i + 1}</div>
                    <span class="text-gray-600">{step}</span>
                  </div>
                  {i < p.steps.length - 1 && <div class="w-px h-4 bg-gray-200 ml-4"></div>}
                </Fragment>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const tabs = document.querySelectorAll('.buyer-tab');
  const panels = document.querySelectorAll('.buyer-panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');

      tabs.forEach((t) => {
        t.classList.remove('active', 'bg-wa-green', 'text-white');
        t.classList.add('text-gray-500');
      });
      tab.classList.add('active', 'bg-wa-green', 'text-white');
      tab.classList.remove('text-gray-500');

      panels.forEach((p) => p.classList.add('hidden'));
      document.getElementById(`panel-${target}`)?.classList.remove('hidden');
    });
  });
</script>

<script is:inline>
  // Journey phone video — same gates as the hero phone. Desktop (>=1024px):
  // muted autoplay loop while on screen and motion is allowed. Mobile: poster
  // + tap-to-play overlay — the tap is the user gesture browsers require, so
  // playback starts WITH sound; afterwards scrolling away pauses and returning
  // resumes it.
  (function () {
    var video = document.querySelector('[data-journey-video]');
    if (!video) return;
    var desktop = window.matchMedia('(min-width: 1024px)');
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    var overlay = document.querySelector('[data-journey-play]');
    var soundBtn = document.querySelector('[data-journey-sound]');
    var iconMuted = soundBtn && soundBtn.querySelector('[data-icon-muted]');
    var iconOn = soundBtn && soundBtn.querySelector('[data-icon-on]');
    var onScreen = true;
    var userStarted = false; // set on first tap — opts the video into resume-on-visible

    function syncSound() {
      if (!soundBtn) return;
      var audible = !video.muted;
      iconMuted.classList.toggle('hidden', audible);
      iconOn.classList.toggle('hidden', !audible);
      soundBtn.setAttribute('aria-pressed', audible ? 'true' : 'false');
      soundBtn.setAttribute('aria-label', audible ? soundBtn.getAttribute('data-label-off') : soundBtn.getAttribute('data-label-on'));
    }
    function syncOverlay() {
      if (overlay) overlay.classList.toggle('hidden', !video.paused);
    }
    function update() {
      if (onScreen && (userStarted || (desktop.matches && !reduced.matches))) {
        var p = video.play();
        if (p && p.catch) p.catch(function () {});
      } else {
        video.pause();
      }
      syncOverlay();
    }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        onScreen = entries[0].isIntersecting;
        update();
      }, { threshold: 0 }).observe(video);
    }
    desktop.addEventListener('change', update);
    reduced.addEventListener('change', update);

    // Mobile: tap the poster overlay to start the video with sound.
    if (overlay) {
      overlay.addEventListener('click', function () {
        userStarted = true;
        video.muted = false;
        video.volume = 1;
        var p = video.play();
        if (p && p.catch) p.catch(function () {});
        syncSound();
        syncOverlay();
      });
    }
    // Sound toggle — video autoplays muted; click unmutes it (user gesture,
    // so autoplay policies are satisfied). Click again to re-mute.
    if (soundBtn) {
      soundBtn.addEventListener('click', function () {
        video.muted = !video.muted;
        if (!video.muted) {
          video.volume = 1;
          var p = video.play();
          if (p && p.catch) p.catch(function () {});
        }
        syncSound();
      });
    }
    syncSound();
    update();
  })();
</script>
