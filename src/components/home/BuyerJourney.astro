---
import SectionHeading from '../shared/SectionHeading.astro';
---

<section class="py-20 sm:py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Why Me? Because Every Conversation Counts."
      subtitle="Whether you're marketing, selling, or supporting — your AI agent handles it all on WhatsApp."
    />

    <!-- Tabs -->
    <div class="flex justify-center mb-12">
      <div class="inline-flex bg-white rounded-xl border border-gray-200 p-1.5 gap-1">
        <button class="buyer-tab active px-5 py-2.5 text-sm font-semibold rounded-lg transition-all" data-tab="marketing">
          For Marketing
        </button>
        <button class="buyer-tab px-5 py-2.5 text-sm font-semibold rounded-lg transition-all text-gray-500 hover:text-gray-700" data-tab="sales">
          For Sales
        </button>
        <button class="buyer-tab px-5 py-2.5 text-sm font-semibold rounded-lg transition-all text-gray-500 hover:text-gray-700" data-tab="support">
          For Support
        </button>
      </div>
    </div>

    <!-- Marketing Panel -->
    <div class="buyer-panel" id="panel-marketing">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Capture leads where they actually respond</h3>
          <p class="text-gray-600 leading-relaxed mb-6">WhatsApp campaigns get 98% open rates. Your AI captures leads, answers product questions, and nurtures prospects — all on autopilot.</p>
          <div class="grid grid-cols-3 gap-6">
            <div>
              <div class="text-3xl font-extrabold text-wa-green">3x</div>
              <div class="text-sm text-gray-500 mt-1">Higher Engagement</div>
            </div>
            <div>
              <div class="text-3xl font-extrabold text-wa-green">98%</div>
              <div class="text-sm text-gray-500 mt-1">Open Rate</div>
            </div>
            <div>
              <div class="text-3xl font-extrabold text-wa-green">24/7</div>
              <div class="text-sm text-gray-500 mt-1">Lead Capture</div>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 p-8 shadow-sm">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-green-50 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-wa-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.001 3.001 0 01-1.564-.317z"/></svg>
            </div>
            <h4 class="font-semibold text-gray-900">Marketing Flow</h4>
          </div>
          <div class="space-y-3">
            <div class="flex items-center gap-3 text-sm">
              <div class="w-8 h-8 bg-wa-green text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0">1</div>
              <span class="text-gray-600">Customer sees your ad or campaign</span>
            </div>
            <div class="w-px h-4 bg-gray-200 ml-4"></div>
            <div class="flex items-center gap-3 text-sm">
              <div class="w-8 h-8 bg-wa-green text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0">2</div>
              <span class="text-gray-600">Sends a WhatsApp message</span>
            </div>
            <div class="w-px h-4 bg-gray-200 ml-4"></div>
            <div class="flex items-center gap-3 text-sm">
              <div class="w-8 h-8 bg-wa-green text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0">3</div>
              <span class="text-gray-600">AI qualifies and captures lead info</span>
            </div>
            <div class="w-px h-4 bg-gray-200 ml-4"></div>
            <div class="flex items-center gap-3 text-sm">
              <div class="w-8 h-8 bg-ai-purple text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0">4</div>
              <span class="text-gray-600">Conversion or handoff to sales team</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sales Panel -->
    <div class="buyer-panel hidden" id="panel-sales">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Close deals faster with AI-powered selling</h3>
          <p class="text-gray-600 leading-relaxed mb-6">Qualify leads, schedule appointments, generate quotes, and close deals — all through WhatsApp. Your AI sales agent works around the clock.</p>
          <div class="grid grid-cols-3 gap-6">
            <div>
              <div class="text-3xl font-extrabold text-wa-green">30%</div>
              <div class="text-sm text-gray-500 mt-1">Shorter Sales Cycle</div>
            </div>
            <div>
              <div class="text-3xl font-extrabold text-wa-green">3x</div>
              <div class="text-sm text-gray-500 mt-1">Faster Response</div>
            </div>
            <div>
              <div class="text-3xl font-extrabold text-wa-green">24/7</div>
              <div class="text-sm text-gray-500 mt-1">Lead Capture</div>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 p-8 shadow-sm">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-blue-50 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-ai-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h4 class="font-semibold text-gray-900">Sales Flow</h4>
          </div>
          <div class="space-y-3">
            <div class="flex items-center gap-3 text-sm">
              <div class="w-8 h-8 bg-wa-green text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0">1</div>
              <span class="text-gray-600">Lead initiates conversation</span>
            </div>
            <div class="w-px h-4 bg-gray-200 ml-4"></div>
            <div class="flex items-center gap-3 text-sm">
              <div class="w-8 h-8 bg-wa-green text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0">2</div>
              <span class="text-gray-600">AI qualifies with smart questions</span>
            </div>
            <div class="w-px h-4 bg-gray-200 ml-4"></div>
            <div class="flex items-center gap-3 text-sm">
              <div class="w-8 h-8 bg-wa-green text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0">3</div>
              <span class="text-gray-600">Books appointment via Google Calendar</span>
            </div>
            <div class="w-px h-4 bg-gray-200 ml-4"></div>
            <div class="flex items-center gap-3 text-sm">
              <div class="w-8 h-8 bg-ai-purple text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0">4</div>
              <span class="text-gray-600">Generates quote and closes the deal</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Support Panel -->
    <div class="buyer-panel hidden" id="panel-support">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Resolve issues before they escalate</h3>
          <p class="text-gray-600 leading-relaxed mb-6">80% of support queries resolved automatically. Your AI agent knows your business inside out and hands off to humans only when needed.</p>
          <div class="grid grid-cols-3 gap-6">
            <div>
              <div class="text-3xl font-extrabold text-wa-green">80%</div>
              <div class="text-sm text-gray-500 mt-1">Auto-Resolved</div>
            </div>
            <div>
              <div class="text-3xl font-extrabold text-wa-green">40%</div>
              <div class="text-sm text-gray-500 mt-1">Less Workload</div>
            </div>
            <div>
              <div class="text-3xl font-extrabold text-wa-green">&lt;1s</div>
              <div class="text-sm text-gray-500 mt-1">Response Time</div>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 p-8 shadow-sm">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-orange-50 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            </div>
            <h4 class="font-semibold text-gray-900">Support Flow</h4>
          </div>
          <div class="space-y-3">
            <div class="flex items-center gap-3 text-sm">
              <div class="w-8 h-8 bg-wa-green text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0">1</div>
              <span class="text-gray-600">Customer asks a question</span>
            </div>
            <div class="w-px h-4 bg-gray-200 ml-4"></div>
            <div class="flex items-center gap-3 text-sm">
              <div class="w-8 h-8 bg-wa-green text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0">2</div>
              <span class="text-gray-600">AI matches answer from knowledge base</span>
            </div>
            <div class="w-px h-4 bg-gray-200 ml-4"></div>
            <div class="flex items-center gap-3 text-sm">
              <div class="w-8 h-8 bg-wa-green text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0">3</div>
              <span class="text-gray-600">Complex issue? Escalated to human agent</span>
            </div>
            <div class="w-px h-4 bg-gray-200 ml-4"></div>
            <div class="flex items-center gap-3 text-sm">
              <div class="w-8 h-8 bg-ai-purple text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0">4</div>
              <span class="text-gray-600">Issue resolved, customer happy</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll('.buyer-tab');
  const panels = document.querySelectorAll('.buyer-panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');

      tabs.forEach((t) => {
        t.classList.remove('active', 'bg-wa-green', 'text-white');
        t.classList.add('text-gray-500');
      });
      tab.classList.add('active', 'bg-wa-green', 'text-white');
      tab.classList.remove('text-gray-500');

      panels.forEach((p) => p.classList.add('hidden'));
      document.getElementById(`panel-${target}`)?.classList.remove('hidden');
    });
  });

  // Set initial active tab
  const firstTab = document.querySelector('.buyer-tab');
  firstTab?.classList.add('bg-wa-green', 'text-white');
</script>
