---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Real customer logos shown as a seamless marquee. The list is duplicated so
// the first half equals the second half — the scroll keyframe translates
// exactly -50%, which makes the loop seamless. Each half is wider than the
// viewport, so the two logos are repeated to fill the strip. Logos are
// pre-flattened to a single dark gray with transparent backgrounds.
const logos = [
  { src: '/images/logos/bace.png', alt: 'BACE Engineering', w: 221, h: 125 },
  { src: '/images/logos/outsource2us.png', alt: 'OUTSOURCE2US', w: 800, h: 263 },
];
const half = Array.from({ length: 12 }, (_, i) => logos[i % logos.length]);
const strip = [...half, ...half];
---

<section class="py-12 border-b border-gray-100 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
    <p class="text-center text-sm font-medium text-gray-500 uppercase tracking-wider">{t('home.logo.title')}</p>
  </div>
  <div class="relative">
    <div class="flex animate-scroll">
      {strip.map((logo) => (
        <div class="flex items-center justify-center shrink-0 px-8 opacity-50 hover:opacity-100 transition-opacity">
          <img
            src={logo.src}
            alt={logo.alt}
            width={logo.w}
            height={logo.h}
            loading="lazy"
            decoding="async"
            draggable="false"
            class="h-9 w-auto select-none"
          />
        </div>
      ))}
    </div>
  </div>
</section>
