---
import SectionHeading from '../shared/SectionHeading.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-20 sm:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title={t('home.ai.title')}
      subtitle={t('home.ai.subtitle')}
      badge={t('home.ai.badge')}
    />

    <div class="grid md:grid-cols-3 gap-8">
      <!-- Card 1 -->
      <div class="relative bg-white rounded-2xl border border-gray-100 p-8 hover:-translate-y-1 hover:shadow-lg transition-all duration-200">
        <div class="w-14 h-14 bg-green-50 rounded-2xl flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-wa-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">{t('home.ai.c1.title')}</h3>
        <p class="text-gray-600 leading-relaxed">{t('home.ai.c1.body')}</p>
      </div>

      <!-- Card 2 -->
      <div class="relative bg-white rounded-2xl border border-gray-100 p-8 hover:-translate-y-1 hover:shadow-lg transition-all duration-200">
        <div class="w-14 h-14 bg-purple-50 rounded-2xl flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-ai-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">{t('home.ai.c2.title')}</h3>
        <p class="text-gray-600 leading-relaxed">{t('home.ai.c2.body')}</p>
      </div>

      <!-- Card 3 -->
      <div class="relative bg-white rounded-2xl border border-gray-100 p-8 hover:-translate-y-1 hover:shadow-lg transition-all duration-200">
        <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-ai-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">{t('home.ai.c3.title')}</h3>
        <p class="text-gray-600 leading-relaxed">{t('home.ai.c3.body')}</p>
      </div>
    </div>
  </div>
</section>
