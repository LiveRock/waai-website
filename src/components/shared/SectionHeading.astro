---
interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  align?: 'center' | 'left';
}

const { title, subtitle, badge, align = 'center' } = Astro.props;

const alignment = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class:list={['max-w-3xl mb-12', alignment]}>
  {badge && (
    <span class="inline-block px-3 py-1 text-xs font-semibold text-wa-green bg-green-50 rounded-full uppercase tracking-wider mb-4">
      {badge}
    </span>
  )}
  <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">{title}</h2>
  {subtitle && (
    <p class="text-lg text-gray-600 leading-relaxed">{subtitle}</p>
  )}
</div>
