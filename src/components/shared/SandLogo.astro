---
// Sand-logo effect — the waai mark as luminous WebGL2 sand grains (see CLAUDE.md
// "404 sand-particle logo" for the full architecture). Render at most once per
// page (hard-coded data-* hooks). `compact` = smaller mark + tighter spacing for
// working pages (contact); default = the large 404 treatment.
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<canvas
  data-sand-canvas
  class="absolute inset-0 h-full w-full pointer-events-none"
  aria-hidden="true"
></canvas>
<div class:list={['relative z-10 pt-6 sm:pt-10', compact ? 'pb-12 sm:pb-14' : 'pb-[140px]']}>
  <div
    data-sand-box
    class:list={[
      'relative mx-auto aspect-square',
      compact
        ? 'w-[180px] min-[480px]:w-[210px] sm:w-[240px] lg:w-[280px]'
        : 'w-[230px] min-[480px]:w-[300px] sm:w-[400px] lg:w-[460px]',
    ]}
  >
    <img
      data-sand-fallback
      src="/images/logos/logo-512.png"
      alt=""
      width="512"
      height="512"
      decoding="async"
      class="h-full w-full object-contain transition-opacity duration-500"
    />
  </div>
</div>

<script>
  // Sand-logo — the waai mark as ~45–90k luminous sand grains (WebGL2 point sprites).
  // Clean-room re-implementation of the "image as sand" effect popularised by
  // gather.be-of-dao.com: grains sampled from the image weighted by luminance × edge
  // strength; ALL motion is a pure function of (grainId, time, splash clock, holes,
  // pointer) in the vertex shader — no physics buffers, one drawArrays per frame.
  // The camera orbits the mark (drag to rotate, gentle sway when idle); a perspective
  // projection gives the relief real depth. Clicking inside the mark punches a local
  // hole in the sand (model space — it rotates with the mark); clicking outside
  // splashes the whole logo. A light bar periodically sweeps top-left → bottom-right
  // and the grains shimmer as it passes.
  // Runs only while on screen and the tab is visible; renders a single static frame
  // when prefers-reduced-motion is set. A plain <img> stays on screen until the first
  // WebGL frames draw (and forever if WebGL2/logo loading is unavailable).
  const canvas = document.querySelector('[data-sand-canvas]');
  // Module state first — boot() below touches these, so they must exist before it runs.
  const ctxWatchers = new WeakSet<HTMLCanvasElement>();
  let stopCurrent: () => void = () => {};

  function boot(canvas: HTMLCanvasElement) {
    const section = canvas.closest('section');
    const box = document.querySelector('[data-sand-box]');
    const fallback = document.querySelector('[data-sand-fallback]');
    if (!section || !(box instanceof HTMLElement) || !(fallback instanceof HTMLImageElement)) return;

    let gl: WebGL2RenderingContext | null = null;
    try {
      gl = canvas.getContext('webgl2', {
        alpha: true,
        premultipliedAlpha: true,
        antialias: false,
        depth: false,
        stencil: false,
        powerPreference: 'low-power',
      });
    } catch {
      gl = null;
    }
    if (!gl) return; // fallback <img> stays

    // Context loss under memory pressure (iOS): fall back to the <img>, and if the
    // context comes back, boot everything again. Registered once — init() re-runs on
    // restore, so a per-boot listener would stack.
    if (!ctxWatchers.has(canvas)) {
      ctxWatchers.add(canvas);
      canvas.addEventListener('webglcontextlost', (e) => {
        e.preventDefault();
        stopCurrent();
        fallback.classList.remove('opacity-0');
      });
      canvas.addEventListener('webglcontextrestored', () => {
        boot(canvas);
      });
    }

    init(canvas, section, box, fallback, gl).catch(() => {
      /* logo fetch/decode failed — fallback <img> stays */
    });
  }

  async function init(
    canvas: HTMLCanvasElement,
    section: HTMLElement,
    box: HTMLElement,
    fallback: HTMLImageElement,
    gl: WebGL2RenderingContext
  ) {
    // (Re)booting on context restore replaces the previous run's stop hook.
    // --- Tunables -----------------------------------------------------------
    const GRID = 512; // logo sampling resolution (logo-512.png is 512²)
    const TEX_W = 512; // grain texture grid — keep in sync with the shader's 512
    const INTRO_END = 3.8; // dust fully gathered by ~3.5s + slack
    const BREATH_PERIOD = 5.6; // s, one slow breath of the whole mark
    const TURB_AMP = 0.004; // idle turbulence amplitude (logo units)
    const CURSOR_SIGMA = 0.10; // pointer influence falloff (half-height units)
    const CURSOR_PUSH = 0.045; // stationary pointer displacement
    const WAKE_SIGMA = 0.16;
    const WAKE_DECAY = 0.35; // s, push fade after the pointer moves on
    const WAKE_GAIN = 0.035; // velocity → push conversion
    const SPLASH_TOTAL = 1.5; // s until fully regathered
    const SPLASH_STAGGER = 0.15; // per-grain delay spread
    const SPLASH_COOLDOWN = 1650; // ms — hard gate: mid-flight retriggers would snap
    const HOLE_R = 0.17; // hole radius (logo units)
    const HOLE_TOTAL = 1.9; // s until the sand flows back in
    const SWEEP_DUR = 1.5; // s, light bar crossing the mark
    const SWEEP_FIRST = 1.2; // s after the intro ends
    const SWEEP_EVERY = [6800, 10400]; // ms random repeat range
    const CAM_DIST = 3.4; // camera distance; fov chosen so the logo plane maps 1:1
    const RELIEF = 0.16; // depth thickness of the mark (logo units)
    const DRAG_SENS = 0.006; // rad per px of drag
    const PITCH_CLAMP = 1.15; // rad, keep away from the gimbal
    const SEED = 0xc0ffee;

    const VERT = `#version 300 es
precision highp float;
precision highp sampler2D;
uniform sampler2D uHomes;  // xy: home (logo units), z: relief -1..1, w: brightness factor
uniform sampler2D uColors; // rgb: grain color
uniform float uTime;
uniform float uIntroEnd;
uniform float uSplashT;    // seconds since splash; large when idle
uniform vec4 uHoles[3];    // xy: hole centre (logo units), z: age s, w: unused
uniform float uSweepT;     // seconds since the light bar started; large when idle
uniform vec4 uWake[3];     // xy: pointer history (half-height units), zw: push
uniform vec4 uCursor;      // xy: smoothed pointer, z: presence 0..1
uniform vec4 uLogo;        // cx, cy, halfW, halfH (half-height units)
uniform mat4 uVP;          // perspective × orbiting view
uniform float uAspect;     // section width / height
uniform float uDist;       // camera distance (logo plane maps 1:1 to the section)
uniform float uGrainSize;  // device px
uniform float uGain;
out vec3 vColor;
out float vAlpha;

float h1(uint n) {
  n = (n << 13u) ^ n;
  n = n * (n * n * 15731u + 789221u) + 1376312589u;
  return float(n & 0x7fffffffu) / float(0x7fffffffu);
}
float smoother(float x) { return x * x * x * (x * (x * 6.0 - 15.0) + 10.0); }

void main() {
  uint vid = uint(gl_VertexID);
  ivec2 tc = ivec2(int(vid % 512u), int(vid / 512u)); // grid must match TEX_W
  vec4 home = texelFetch(uHomes, tc, 0);
  vec3 rgb = texelFetch(uColors, tc, 0).rgb;

  float r1 = h1(vid * 3u + 17u);
  float r2 = h1(vid * 5u + 29u);
  float r3 = h1(vid * 7u + 43u);
  float r4 = h1(vid * 11u + 71u);
  float r5 = h1(vid * 13u + 113u);
  float r6 = h1(vid * 17u + 191u);

  // Model space: x/y in logo units (mark spans ±0.5), z = relief thickness.
  vec3 m = vec3(home.xy, home.z * ${RELIEF.toFixed(2)});
  float alpha = 1.0;
  float bright = 0.1 * m.z; // nearer grains catch a little more light

  // Intro: scattered dust gathers into the mark — staggered, arced, eased.
  if (uTime < uIntroEnd) {
    float delay = 0.4 + 0.9 * r1;
    float dur = 1.4 + 0.8 * r2;
    float t = clamp((uTime - delay) / dur, 0.0, 1.0);
    float e = smoother(t);
    float ang = r3 * 6.2831853;
    float rad = 0.55 + 0.55 * r4;
    vec3 start = vec3(cos(ang) * rad, sin(ang) * rad * 0.8, (r5 - 0.5) * 0.6);
    vec3 arcDir = normalize(vec3(-sin(ang), cos(ang), (r6 - 0.5) * 0.8));
    m = mix(start, m, e) + arcDir * sin(3.14159265 * t) * (0.08 + 0.25 * r2);
    alpha = smoothstep(0.0, 0.25, t);
  }

  // Breathing: one slow, slightly asymmetric breath of the whole mark.
  float bx = fract(uTime / ${BREATH_PERIOD.toFixed(1)} + (r5 - 0.5) * 0.12);
  float tri = bx < 0.58 ? bx / 0.58 : 1.0 - (bx - 0.58) / 0.42;
  float b = sin(tri * 3.14159265); // 0 → 1 → 0, smooth
  m.xy *= 1.0 + 0.011 * b;
  m.z += 0.05 * b * home.z;

  // Idle turbulence: sum of sines, per-grain frequency jitter — never quite still.
  float tt = uTime;
  m.xy += ${TURB_AMP.toFixed(3)} * vec2(
    sin((0.7 + 0.6 * r1) * 1.7 * tt + r2 * 6.2831) + 0.5 * sin((0.7 + 0.6 * r3) * 3.1 * tt + r4 * 6.2831),
    cos((0.7 + 0.6 * r2) * 1.3 * tt + r3 * 6.2831) + 0.5 * sin((0.7 + 0.6 * r4) * 2.3 * tt + r1 * 6.2831)
  );

  // Holes: a poke throws the local sand out to the rim, then it flows back in.
  // Model space, so a hole stays put while the mark is turned.
  for (int k = 0; k < 3; k++) {
    float age = uHoles[k].z;
    if (age < 0.0 || age > ${HOLE_TOTAL.toFixed(1)}) continue;
    vec2 d = m.xy - uHoles[k].xy;
    float dist = length(d);
    if (dist > ${(HOLE_R * 1.7).toFixed(2)}) continue;
    float env = (1.0 - exp(-14.0 * age)) * (1.0 - smoother(clamp((age - 0.5) / 1.1, 0.0, 1.0)));
    vec2 dir = d / max(dist, 0.001);
    float inside = max(0.0, ${HOLE_R.toFixed(2)} - dist);
    m.xy += dir * inside * 1.5 * env;              // cleared disc
    m.z += (r6 - 0.5) * 0.28 * env * smoothstep(${(HOLE_R * 1.6).toFixed(2)}, 0.0, dist); // scatter
    float rd = (dist - ${HOLE_R.toFixed(2)}) / 0.07; // lit rim (pow of negatives is NaN in GLSL)
    bright += 0.9 * env * exp(-rd * rd);
  }

  // Splash: the hit throws the whole mark outward, then every grain is drawn home.
  float tau = uSplashT - ${SPLASH_STAGGER.toFixed(2)} * r6;
  if (tau >= 0.0 && tau < ${SPLASH_TOTAL.toFixed(1)}) {
    float mm = (1.0 - exp(-12.0 * tau)) * (1.0 - smoother(clamp((tau - 0.45) / 1.05, 0.0, 1.0)));
    vec2 dir = normalize(home.xy + (vec2(r1, r2) - 0.5) * 0.8 + vec2(0.0013, 0.0007));
    float reach = 0.18 + 0.38 * r3 * r3; // most grains go a little way, a few go far
    m.xy += dir * reach * mm;
    m.z += sin(3.14159265 * tau / ${SPLASH_TOTAL.toFixed(1)}) * 0.4 * r4; // loft
    bright += 0.8 * mm;
  }

  // Model → world (half-height units; the mark lies in the z=0 plane through uLogo.xy).
  vec3 world = vec3(uLogo.xy + m.xy * (2.0 * uLogo.zw), m.z * 2.0 * uLogo.w);
  vec4 clip = uVP * vec4(world, 1.0);

  // View space (what the user sees at the logo plane): pointer, wake, light bar.
  vec2 view = (clip.xy / clip.w) * vec2(uAspect, 1.0);
  vec2 push = vec2(0.0);

  // Pointer: a finger held in the sand — near grains ease away and catch light.
  vec2 cd = view - uCursor.xy;
  float cf = exp(-dot(cd, cd) / ${(CURSOR_SIGMA * CURSOR_SIGMA).toFixed(4)}) * uCursor.z;
  push += (cd / max(length(cd), 0.001)) * cf * ${CURSOR_PUSH.toFixed(3)};
  bright += 0.4 * cf;

  // Wake: the trail the pointer leaves — pushes and stirs, then lets go.
  for (int k = 0; k < 3; k++) {
    vec2 d = view - uWake[k].xy;
    float f = exp(-dot(d, d) / ${(WAKE_SIGMA * WAKE_SIGMA).toFixed(4)});
    float pw = length(uWake[k].zw);
    push += (uWake[k].zw + vec2(-d.y, d.x) * 0.5) * f; // push + swirl
    bright += 1.2 * f * min(1.0, pw * 12.0);
  }

  // Light bar: a diagonal shine sweeping top-left → bottom-right; grains shimmer
  // (and swell a touch) as it crosses them.
  if (uSweepT >= 0.0 && uSweepT < ${SWEEP_DUR.toFixed(1)}) {
    vec2 n = vec2(0.70710678);           // travel direction (1,1)/√2 in view units
    float prog = uSweepT / ${SWEEP_DUR.toFixed(1)};
    float span = 1.15 * (uAspect + 1.0); // corner-to-corner travel
    float centre = -0.5 * span + prog * span;
    float dist = dot(view, n) - centre;  // signed distance along the travel axis
    float nd = dist / 0.16;              // (pow of negatives is NaN in GLSL)
    float band = exp(-nd * nd);
    bright += band * (1.0 + 0.8 * r5);   // per-grain sparkle variance
  }

  clip.xy += (push / vec2(uAspect, 1.0)) * clip.w; // screen-space push survives rotation
  gl_Position = clip;
  float size = uGrainSize * (0.6 + 0.9 * r4) * (uDist / max(clip.w, 0.1)) * (1.0 + 0.35 * min(bright, 1.2));
  gl_PointSize = max(size, 1.0);
  vColor = rgb * home.w * uGain * (0.9 + 0.2 * r1) * (1.0 + min(bright, 1.0));
  vAlpha = alpha;
}`;

    const FRAG = `#version 300 es
precision mediump float;
in vec3 vColor;
in float vAlpha;
out vec4 o;
void main() {
  float r = length(gl_PointCoord - 0.5) * 2.0;
  float a = smoothstep(1.0, 0.35, r) * vAlpha;
  o = vec4(vColor * a, a); // premultiplied — additive-style blend over the page
}`;

    // --- GL boot --------------------------------------------------------------
    const prog = buildProgram(gl, VERT, FRAG);
    if (!prog) return;
    gl.useProgram(prog);
    const u: Record<string, WebGLUniformLocation | null> = {};
    for (const name of [
      'uHomes', 'uColors', 'uTime', 'uIntroEnd', 'uSplashT', 'uHoles[0]', 'uSweepT',
      'uWake[0]', 'uCursor', 'uLogo', 'uVP', 'uAspect', 'uDist', 'uGrainSize', 'uGain',
    ]) {
      u[name] = gl.getUniformLocation(prog, name);
    }
    gl.uniform1i(u['uHomes'], 0);
    gl.uniform1i(u['uColors'], 1);
    gl.uniform1f(u['uIntroEnd'], INTRO_END);
    gl.uniform1f(u['uDist'], CAM_DIST);
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_COLOR);
    gl.clearColor(0, 0, 0, 0);
    gl.bindVertexArray(gl.createVertexArray()); // attribute-less draw; VAO for old-driver safety

    // --- Grains: the logo sampled into sand (all randomness lives here) -------
    const img = await loadLogo();
    if (!img || gl.isContextLost()) return;
    const grains = buildGrains(img, section.clientWidth);
    if (!grains || gl.isContextLost()) return;

    const homes = gl.createTexture()!;
    gl.activeTexture(gl.TEXTURE0);
    gl.bindTexture(gl.TEXTURE_2D, homes);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA32F, TEX_W, grains.texH, 0, gl.RGBA, gl.FLOAT, grains.pos);
    const colors = gl.createTexture()!;
    gl.activeTexture(gl.TEXTURE1);
    gl.bindTexture(gl.TEXTURE_2D, colors);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, TEX_W, grains.texH, 0, gl.RGBA, gl.UNSIGNED_BYTE, grains.col);
    for (const t of [homes, colors]) {
      gl.bindTexture(gl.TEXTURE_2D, t);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    }
    if (gl.getError() !== gl.NO_ERROR) {
      console.warn('[sand-logo] texture upload failed — fallback stays');
      return;
    }

    const N = grains.n;
    const pointMax = (gl.getParameter(gl.ALIASED_POINT_SIZE_RANGE) as Float32Array)[1] || 64;

    // --- State ----------------------------------------------------------------
    let cssW = 0;
    let cssH = 0;
    let rafId = 0;
    let t0 = 0;
    let last = 0;
    let intersecting = false;
    let splashT0 = -1;
    let lastSplash = -Infinity;
    let fallbackHidden = false;
    let resizeTimer: ReturnType<typeof setTimeout> | 0 = 0;
    const wake = [
      { x: 9, y: 9, px: 0, py: 0 },
      { x: 9, y: 9, px: 0, py: 0 },
      { x: 9, y: 9, px: 0, py: 0 },
    ];
    const holes: { x: number; y: number; t0: number }[] = [];
    let sweepT0 = -1;
    let nextSweep = 0;
    let cursorX = 9;
    let cursorY = 9;
    let cursorOn = 0; // spring-smoothed presence 0..1
    let mouseOn = false;
    let mouseClientX = 0;
    let mouseClientY = 0;
    let prevClientX = 0;
    let prevClientY = 0;
    let prevMoveT = 0;
    // Camera orbit: user drag + gentle idle sway.
    let yaw = 0;
    let pitch = 0;
    let dragging = false;
    let dragCandidate = false;
    let dragX = 0;
    let dragY = 0;
    let moved = 0;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const controller = new AbortController();
    const sig = { signal: controller.signal };

    // --- Camera ---------------------------------------------------------------
    // Perspective with fov chosen so the z=0 logo plane maps 1:1 onto the section
    // (tan(fov/2) = 1/dist): relief depth reads as real parallax, sizes stay stable.
    // Column-major 4×4s throughout (uniformMatrix4fv transpose=false).
    const NEAR = 0.5, FAR = 30;
    let aspect = 1;
    const proj = new Float32Array(16);
    const viewM = new Float32Array(16);
    const vp = new Float32Array(16);

    function mul4(a: Float32Array, b: Float32Array, out: Float32Array) {
      for (let c = 0; c < 4; c++) {
        for (let r = 0; r < 4; r++) {
          out[c * 4 + r] =
            a[r] * b[c * 4] + a[4 + r] * b[c * 4 + 1] + a[8 + r] * b[c * 4 + 2] + a[12 + r] * b[c * 4 + 3];
        }
      }
    }

    function buildProj() {
      const f = CAM_DIST; // 1/tan(fov/2), tan = 1/dist → logo plane maps 1:1
      const nf = 1 / (NEAR - FAR);
      proj.fill(0);
      proj[0] = f / Math.max(aspect, 0.001);
      proj[5] = f;
      proj[10] = (FAR + NEAR) * nf;
      proj[11] = -1;
      proj[14] = 2 * FAR * NEAR * nf;
    }

    function buildView(yaw: number, pitch: number, cx: number, cy: number) {
      const cp = Math.cos(pitch), sp = Math.sin(pitch), cyw = Math.cos(yaw), syw = Math.sin(yaw);
      // eye = C + dist·(sy·cp, sp, cy·cp); forward f = −e; right r = normalize(f × up);
      // up u = r × f. (r = (cy, 0, −sy) after normalisation — cp cancels.)
      const fx = -syw * cp, fy = -sp, fz = -cyw * cp;
      const rx = cyw, ry = 0, rz = -syw;
      const ux = ry * fz - rz * fy, uy = rz * fx - rx * fz, uz = rx * fy - ry * fx;
      const ex = cx + CAM_DIST * syw * cp, ey = cy + CAM_DIST * sp, ez = CAM_DIST * cyw * cp;
      viewM[0] = rx; viewM[1] = ux; viewM[2] = -fx; viewM[3] = 0;
      viewM[4] = ry; viewM[5] = uy; viewM[6] = -fy; viewM[7] = 0;
      viewM[8] = rz; viewM[9] = uz; viewM[10] = -fz; viewM[11] = 0;
      viewM[12] = -(rx * ex + ry * ey + rz * ez);
      viewM[13] = -(ux * ex + uy * ey + uz * ez);
      viewM[14] = fx * ex + fy * ey + fz * ez;
      viewM[15] = 1;
    }

    function viewProj(yaw: number, pitch: number, cx: number, cy: number) {
      buildView(yaw, pitch, cx, cy);
      mul4(proj, viewM, vp);
    }

    // --- Sizing (homes are logo-local — resize only re-anchors) ---------------
    let logoRect: [number, number, number, number] = [0, 0, 0.4, 0.4]; // cx, cy, halfW, halfH
    function clamp(v: number, lo: number, hi: number) {
      return Math.max(lo, Math.min(hi, v));
    }
    function fit() {
      // Fully rect-based (never mix clientWidth/Height with getBoundingClientRect):
      // on iOS the two can disagree while the dynamic viewport settles, which
      // anchored the mark below its box. Rects read in the same tick cancel scroll.
      const sr = section.getBoundingClientRect();
      const br = box.getBoundingClientRect();
      cssW = Math.max(1, sr.width);
      cssH = Math.max(1, sr.height);
      const dpr = Math.min(window.devicePixelRatio || 1, cssW < 660 ? 1.5 : 2);
      canvas.width = Math.round(cssW * dpr);
      canvas.height = Math.round(cssH * dpr);
      gl.viewport(0, 0, canvas.width, canvas.height);
      aspect = cssW / cssH;
      buildProj();
      const hh = cssH / 2;
      logoRect = [
        (br.left + br.width / 2 - sr.left - cssW / 2) / hh,
        -(br.top + br.height / 2 - sr.top - cssH / 2) / hh,
        br.width / 2 / hh,
        br.height / 2 / hh,
      ];
      gl.uniform4f(u['uLogo'], logoRect[0], logoRect[1], logoRect[2], logoRect[3]);
      gl.uniform1f(u['uAspect'], aspect);
      // Grain size and gain per tier — the mark is denser per pixel on mobile
      // (fewer px, similar grain count), so gain drops to keep it from blowing out.
      const base = cssW < 660 ? 2.0 : cssW < 1024 ? 1.8 : 1.6;
      const gain = cssW < 660 ? 0.6 : cssW < 1024 ? 0.85 : 0.78;
      const maxBoost = 1.5 * 1.25 * 1.42; // size jitter × perspective × bright ceilings
      gl.uniform1f(u['uGrainSize'], Math.min(base * dpr, pointMax / maxBoost));
      gl.uniform1f(u['uGain'], gain);
    }

    // --- Frame ----------------------------------------------------------------
    const holesFlat = new Float32Array(12);
    const wakeFlat = new Float32Array(12);
    function draw(t: number, splashT: number, sweepT: number) {
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.uniform1f(u['uTime'], t);
      gl.uniform1f(u['uSplashT'], splashT);
      gl.uniform1f(u['uSweepT'], sweepT);
      gl.uniform4f(u['uCursor'], cursorX, cursorY, cursorOn, 0);
      for (let k = 0; k < 3; k++) {
        wakeFlat[4 * k] = wake[k].x;
        wakeFlat[4 * k + 1] = wake[k].y;
        wakeFlat[4 * k + 2] = wake[k].px;
        wakeFlat[4 * k + 3] = wake[k].py;
      }
      gl.uniform4fv(u['uWake[0]'], wakeFlat);
      for (let k = 0; k < 3; k++) {
        const h = holes[k];
        holesFlat[4 * k] = h ? h.x : 0;
        holesFlat[4 * k + 1] = h ? h.y : 0;
        holesFlat[4 * k + 2] = h ? t - h.t0 : -1;
        holesFlat[4 * k + 3] = 0;
      }
      gl.uniform4fv(u['uHoles[0]'], holesFlat);
      gl.uniformMatrix4fv(u['uVP'], false, vp);
      gl.drawArrays(gl.POINTS, 0, N);
    }

    // Re-anchor every frame from live rects: whatever the browser does to the
    // layout after boot (iOS dynamic viewport, font swap), the sand follows the
    // <img>'s box within a frame — no stale-measurement drift possible.
    function reanchor() {
      const sr = section.getBoundingClientRect();
      const br = box.getBoundingClientRect();
      const w = Math.max(1, sr.width);
      const h = Math.max(1, sr.height);
      const cx = (br.left + br.width / 2 - sr.left - w / 2) / (h / 2);
      const cy = -(br.top + br.height / 2 - sr.top - h / 2) / (h / 2);
      const hw = br.width / 2 / (h / 2);
      const hh = br.height / 2 / (h / 2);
      const asp = w / h;
      if (
        Math.abs(cx - logoRect[0]) < 0.001 && Math.abs(cy - logoRect[1]) < 0.001 &&
        Math.abs(hw - logoRect[2]) < 0.001 && Math.abs(hh - logoRect[3]) < 0.001 &&
        Math.abs(asp - aspect) < 0.001
      ) {
        return;
      }
      logoRect = [cx, cy, hw, hh];
      aspect = asp;
      buildProj();
      gl.uniform4f(u['uLogo'], cx, cy, hw, hh);
      gl.uniform1f(u['uAspect'], aspect);
      if (Math.abs(w - cssW) > 0.5 || Math.abs(h - cssH) > 0.5) {
        // Section resized — the backing store must follow or the drawing stretches.
        cssW = w;
        cssH = h;
        const dpr = Math.min(window.devicePixelRatio || 1, w < 660 ? 1.5 : 2);
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        gl.viewport(0, 0, canvas.width, canvas.height);
      }
    }

    function frame(now: number) {
      const dt = Math.min(now - last, 50);
      last = now;
      const t = (now - t0) / 1000;
      const splashT = splashT0 < 0 ? 1e9 : (now - splashT0) / 1000;

      // Light bar: first sweep shortly after the dust settles, then every so often.
      if (t >= INTRO_END) {
        if (!nextSweep) {
          nextSweep = t + SWEEP_FIRST;
        } else if (t >= nextSweep) {
          sweepT0 = now;
          nextSweep = t + (SWEEP_EVERY[0] + Math.random() * (SWEEP_EVERY[1] - SWEEP_EVERY[0])) / 1000;
        }
      }
      const sweepT = sweepT0 < 0 ? 1e9 : (now - sweepT0) / 1000;

      // Pointer → section space (half-height units), spring-smoothed.
      const k = 1 - Math.exp(-10 * (dt / 1000));
      if (mouseOn) {
        const rect = canvas.getBoundingClientRect();
        const hh = rect.height / 2;
        const tx = (mouseClientX - rect.left - rect.width / 2) / hh;
        const ty = -(mouseClientY - rect.top - rect.height / 2) / hh;
        cursorX += (tx - cursorX) * k;
        cursorY += (ty - cursorY) * k;
      }
      cursorOn += ((mouseOn ? 1 : 0) - cursorOn) * (1 - Math.exp(-6 * (dt / 1000)));

      // Wake pushes decay; the trail relaxes back into the sand.
      const decay = Math.exp(-dt / 1000 / WAKE_DECAY);
      for (const wk of wake) {
        wk.px *= decay;
        wk.py *= decay;
      }
      while (holes.length && t - holes[holes.length - 1].t0 > HOLE_TOTAL + 0.3) holes.pop();

      // Camera: gentle sway when idle, the user's drag angle on top. The look-at
      // target is the SECTION centre (world origin) — targeting the mark would
      // re-centre the whole scene on the canvas and detach it from its box.
      const swayYaw = 0.16 * Math.sin(0.23 * t);
      const swayPitch = 0.05 * Math.sin(0.17 * t + 1);
      reanchor();
      viewProj(yaw + swayYaw, pitch + swayPitch, 0, 0);

      draw(t, splashT, sweepT);
      if (t >= 0.9 && !fallbackHidden) {
        // Cross-fade the <img> out once the gathering dust can carry the mark —
        // reads as the logo crumbling into sand, not as a flash.
        fallbackHidden = true;
        fallback.classList.add('opacity-0');
      }
      rafId = requestAnimationFrame(frame);
    }

    function updateRunning() {
      const should = intersecting && !document.hidden && !reducedMotion && !gl.isContextLost();
      if (should && !rafId) {
        last = performance.now();
        rafId = requestAnimationFrame(frame);
      } else if (!should && rafId) {
        cancelAnimationFrame(rafId);
        rafId = 0;
      }
    }

    function stop() {
      controller.abort();
      if (rafId) cancelAnimationFrame(rafId);
      rafId = 0;
    }
    stopCurrent = stop; // context-loss handler stops this run (see boot)

    // --- Input: drag rotates, click pokes (inside the mark) or splashes --------
    function pointerToView(e: { clientX: number; clientY: number }): { x: number; y: number } {
      const rect = canvas.getBoundingClientRect();
      const hh = rect.height / 2;
      return {
        x: (e.clientX - rect.left - rect.width / 2) / hh,
        y: -(e.clientY - rect.top - rect.height / 2) / hh,
      };
    }
    function viewToModel(x: number, y: number): { x: number; y: number } {
      // The mark lies in the z=0 plane through its centre — undo the fit() mapping.
      const r = logoRect;
      return { x: (x - r[0]) / (2 * r[2]), y: (y - r[1]) / (2 * r[3]) };
    }

    section.addEventListener(
      'pointerdown',
      (e) => {
        if (e.target instanceof Element && e.target.closest('a, button')) return;
        dragCandidate = true;
        dragging = false;
        moved = 0;
        dragX = e.clientX;
        dragY = e.clientY;
        try {
          section.setPointerCapture(e.pointerId);
        } catch {
          /* capture is best-effort */
        }
      },
      sig
    );
    section.addEventListener(
      'pointermove',
      (e) => {
        if (dragCandidate) {
          const dx = e.clientX - dragX;
          const dy = e.clientY - dragY;
          moved += Math.abs(dx) + Math.abs(dy);
          if (moved > 6) dragging = true;
          if (dragging) {
            yaw += dx * DRAG_SENS;
            pitch = clamp(pitch - dy * DRAG_SENS, -PITCH_CLAMP, PITCH_CLAMP);
            dragX = e.clientX;
            dragY = e.clientY;
            return; // rotating — don't stir the wake with the same gesture
          }
        }
        if (e.pointerType && e.pointerType !== 'mouse') return; // touch drag-scroll must not stir
        const p = pointerToView(e);
        const now = performance.now();
        const mdt = Math.max(8, now - prevMoveT);
        if (mouseOn) {
          // A moved-through spot keeps pushing for a moment, then lets go.
          let vx = ((e.clientX - prevClientX) / mdt) * WAKE_GAIN * (cssH / 300);
          let vy = (-(e.clientY - prevClientY) / mdt) * WAKE_GAIN * (cssH / 300);
          const vm = Math.hypot(vx, vy);
          if (vm > 0.09) {
            vx = (vx / vm) * 0.09;
            vy = (vy / vm) * 0.09;
          }
          wake[2] = wake[1];
          wake[1] = wake[0];
          wake[0] = { x: p.x, y: p.y, px: vx, py: vy };
        }
        prevClientX = e.clientX;
        prevClientY = e.clientY;
        prevMoveT = now;
        mouseOn = true;
        mouseClientX = e.clientX;
        mouseClientY = e.clientY;
      },
      sig
    );
    function endPointer(e: PointerEvent) {
      if (!dragCandidate) return;
      const wasDrag = dragging;
      dragCandidate = false;
      dragging = false;
      if (wasDrag) return;
      // Every click explodes the mark; clicking ON the mark additionally pokes a
      // hole at the click point (one shared cooldown so rapid clicks are consistent).
      const now = performance.now();
      if (now - lastSplash < SPLASH_COOLDOWN) return;
      lastSplash = now;
      splashT0 = now;
      const p = pointerToView(e);
      const mdl = viewToModel(p.x, p.y);
      if (mdl && Math.abs(mdl.x) <= 0.5 && Math.abs(mdl.y) <= 0.5) {
        holes.unshift({ x: mdl.x, y: mdl.y, t0: (now - t0) / 1000 });
        if (holes.length > 3) holes.length = 3;
      }
    }
    section.addEventListener('pointerup', endPointer, sig);
    section.addEventListener('pointercancel', () => {
      dragCandidate = false;
      dragging = false;
    }, sig);

    document.addEventListener('pointerleave', () => (mouseOn = false), sig);

    // --- Boot -----------------------------------------------------------------
    fit();

    if (reducedMotion) {
      // One static frame of the formed mark — no listeners, no loop.
      cursorOn = 0;
      viewProj(0, 0, 0, 0);
      draw(INTRO_END + 1, 1e9, 1e9);
      fallbackHidden = true;
      fallback.classList.add('opacity-0');
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        intersecting = entries[0].isIntersecting;
        updateRunning();
      },
      { threshold: 0 }
    );
    io.observe(section);

    const ro = new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(fit, 150); // homes are logo-local: re-anchor only
    });
    ro.observe(section);

    // Late layout settles (webfont swap, iOS dynamic viewport) re-anchor the mark.
    if (document.fonts?.ready) {
      document.fonts.ready.then(() => fit()).catch(() => {});
    }
    setTimeout(fit, 800);

    document.addEventListener('visibilitychange', updateRunning, sig);
    window.addEventListener('pagehide', stop, sig);

    t0 = performance.now();
    last = t0;
    updateRunning();
  }

  // --- Logo → grains ----------------------------------------------------------
  function loadLogo(): Promise<ImageBitmap | HTMLImageElement | null> {
    return fetch('/images/logos/logo-512.png')
      .then((res) => (res.ok ? res.blob() : Promise.reject(new Error('HTTP ' + res.status))))
      .then((blob) => {
        if ('createImageBitmap' in window) return createImageBitmap(blob);
        return new Promise<HTMLImageElement>((resolve, reject) => {
          const url = URL.createObjectURL(blob);
          const img = new Image();
          img.onload = () => {
            URL.revokeObjectURL(url);
            resolve(img);
          };
          img.onerror = () => {
            URL.revokeObjectURL(url);
            reject(new Error('decode failed'));
          };
          img.src = url;
        });
      })
      .catch(() => null);
  }

  function buildGrains(
    src: ImageBitmap | HTMLImageElement,
    sectionW: number
  ): { pos: Float32Array; col: Uint8Array; n: number; texH: number } | null {
    const GRID = 512;
    const TEX_W = 512;
    const n = sectionW >= 1024 ? 90000 : sectionW < 660 ? 38000 : 60000;
    const texH = Math.ceil(n / TEX_W);
    const c = document.createElement('canvas');
    c.width = c.height = GRID;
    const g = c.getContext('2d', { willReadFrequently: true });
    if (!g) return null;
    g.drawImage(src, 0, 0, GRID, GRID);
    let data: Uint8ClampedArray;
    try {
      data = g.getImageData(0, 0, GRID, GRID).data;
    } catch {
      return null;
    }

    const px = GRID * GRID;
    const alpha = new Float32Array(px);
    const lum = new Float32Array(px);
    for (let i = 0; i < px; i++) {
      const a = data[4 * i + 3] / 255;
      alpha[i] = a;
      if (a > 0.004) {
        lum[i] =
          (0.2126 * data[4 * i] + 0.7152 * data[4 * i + 1] + 0.0722 * data[4 * i + 2]) / 255;
      }
    }

    // Edges (central differences of alpha) sample denser — crisp glowing contours.
    const edge = new Float32Array(px);
    for (let y = 1; y < GRID - 1; y++) {
      for (let x = 1; x < GRID - 1; x++) {
        const i = y * GRID + x;
        const gx = alpha[i + 1] - alpha[i - 1];
        const gy = alpha[i + GRID] - alpha[i - GRID];
        edge[i] = Math.min(1, 3.5 * Math.hypot(gx, gy));
      }
    }

    // Relief: blurred alpha → z, so stroke centres sit slightly nearer than edges.
    const relief = boxBlur(boxBlur(alpha, GRID, GRID, 6), GRID, GRID, 6);

    // Weighted CDF over luminance × edge (× alpha) — sand follows the mark's shading.
    const cdf = new Float64Array(px);
    let total = 0;
    for (let i = 0; i < px; i++) {
      let w = 0;
      if (alpha[i] > 0.02) {
        w = Math.pow(alpha[i], 1.15) * (0.3 + 0.7 * lum[i]) * (0.55 + 0.45 * edge[i]);
      }
      total += w;
      cdf[i] = total;
    }
    if (total <= 0) return null;

    const rand = mulberry32(0xc0ffee);
    // Buffers must exactly fill the texture grid (texImage2D rejects short data
    // with a silent GL error → an all-zeros homes texture → grains at the centre).
    const texLen = TEX_W * texH * 4;
    const pos = new Float32Array(texLen);
    const col = new Uint8Array(texLen);
    for (let k = 0; k < n; k++) {
      const target = rand() * total;
      let lo = 0;
      let hi = px - 1;
      while (lo < hi) {
        const mid = (lo + hi) >> 1;
        if (cdf[mid] < target) lo = mid + 1;
        else hi = mid;
      }
      const i = lo;
      const x = i % GRID;
      const y = (i / GRID) | 0;
      pos[4 * k] = (x + 0.5) / GRID - 0.5;
      pos[4 * k + 1] = 0.5 - (y + 0.5) / GRID; // y up
      pos[4 * k + 2] = relief[i] * 2 - 1;
      pos[4 * k + 3] = 0.75 + 0.25 * lum[i]; // brighter pixels glow brighter
      const j = 0.85 + 0.3 * rand(); // per-grain luminance jitter
      // Gamma-lift sampled colors: dark tones (the mark's deep purple side) would
      // vanish under additive blending on the dark teal — lift keeps hue, adds glow.
      const GAMMA = 0.72;
      col[4 * k] = Math.min(255, 255 * Math.pow((data[4 * i] / 255) * j, GAMMA));
      col[4 * k + 1] = Math.min(255, 255 * Math.pow((data[4 * i + 1] / 255) * j, GAMMA));
      col[4 * k + 2] = Math.min(255, 255 * Math.pow((data[4 * i + 2] / 255) * j, GAMMA));
      col[4 * k + 3] = 255;
    }
    return { pos, col, n, texH };
  }

  function boxBlur(src: Float32Array, w: number, h: number, r: number): Float32Array {
    const tmp = new Float32Array(src.length);
    const out = new Float32Array(src.length);
    const win = 2 * r + 1;
    for (let y = 0; y < h; y++) {
      let acc = 0;
      for (let x = -r; x <= r; x++) acc += src[y * w + Math.min(w - 1, Math.max(0, x))];
      for (let x = 0; x < w; x++) {
        tmp[y * w + x] = acc / win;
        acc += src[y * w + Math.min(w - 1, x + r + 1)] - src[y * w + Math.max(0, x - r)];
      }
    }
    for (let x = 0; x < w; x++) {
      let acc = 0;
      for (let y = -r; y <= r; y++) acc += tmp[Math.min(h - 1, Math.max(0, y)) * w + x];
      for (let y = 0; y < h; y++) {
        out[y * w + x] = acc / win;
        acc += tmp[Math.min(h - 1, y + r + 1) * w + x] - tmp[Math.max(0, y - r) * w + x];
      }
    }
    return out;
  }

  function mulberry32(seed: number) {
    let a = seed >>> 0;
    return () => {
      a = (a + 0x6d2b79f5) >>> 0;
      let t = a;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function buildProgram(gl: WebGL2RenderingContext, vert: string, frag: string): WebGLProgram | null {
    const p = gl.createProgram();
    if (!p) return null;
    for (const [type, src] of [
      [gl.VERTEX_SHADER, vert],
      [gl.FRAGMENT_SHADER, frag],
    ] as [number, string][]) {
      const sh = gl.createShader(type);
      if (!sh) return null;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
        console.warn('[sand-logo] shader:', gl.getShaderInfoLog(sh));
        return null;
      }
      gl.attachShader(p, sh);
    }
    gl.linkProgram(p);
    if (!gl.getProgramParameter(p, gl.LINK_STATUS)) {
      console.warn('[sand-logo] link:', gl.getProgramInfoLog(p));
      return null;
    }
    return p;
  }

  // Boot last — everything above is hoisted or already initialized.
  if (canvas) boot(canvas as HTMLCanvasElement);
</script>
