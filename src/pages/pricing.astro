---
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeading from '../components/shared/SectionHeading.astro';
import CTAButton from '../components/shared/CTAButton.astro';
import Accordion from '../components/shared/Accordion.astro';

const API_URLS = [
  'http://127.0.0.1:8000/api/public/plans',
  'https://waaichat.hsi.asia/api/public/plans',
];

let dbPlans: { name: string; display_name: string; description: string | null; price_monthly: number; price_yearly: number; max_qa_pairs: number | null; max_flows: number | null; max_messages_monthly: number | null; trial_days: number | null }[] = [];
for (const url of API_URLS) {
  try {
    const res = await fetch(url);
    if (res.ok) { dbPlans = await res.json(); break; }
  } catch {}
}

function formatPrice(cents: number | null | undefined): string {
  if (cents === null || cents === undefined) return 'Contact';
  if (cents === 0) return 'Free';
  const dollars = cents / 100;
  return dollars % 1 === 0 ? `$${dollars.toLocaleString()}` : `$${dollars.toFixed(2)}`;
}

function formatLimit(val: number | null | undefined): string {
  if (val === null || val === undefined) return 'Unlimited';
  return val.toLocaleString();
}

const planFeatureMap: Record<string, string[]> = {
  trial: ['AI Auto-Responder', 'Knowledge Base', 'Test Chat'],
  starter: ['AI Auto-Responder', 'Knowledge Base', 'Logic Flows', 'Analytics Dashboard', 'Business Templates', 'CSV/JSON Import'],
  pro: ['Everything in Starter', 'Google Workspace Plugins', 'Super Powers (Vision, Web Search)', 'Document Generation', 'AI Multi-Provider', 'Priority Support'],
};

// Build plans from DB data; fall back to hardcoded if API unreachable
const plans = dbPlans.length > 0
  ? dbPlans.map((p) => ({
      name: p.name,
      display_name: p.display_name,
      key: p.name,
      price: formatPrice(p.price_monthly),
      period: p.price_monthly === 0 ? `${p.trial_days || 14} days` : '/month',
      yearlyPrice: p.price_yearly > 0 ? `${formatPrice(p.price_yearly)}/year` : '',
      description: p.description || '',
      highlighted: p.name === 'pro',
      cta: p.name === 'custom' ? 'Contact Sales' : 'Start Free Trial',
      ctaHref: p.name === 'custom' ? '/contact' : '/signup',
      features: [
        ...(p.max_qa_pairs ? [`${formatLimit(p.max_qa_pairs)} Q&A Pairs`] : ['Unlimited Q&A Pairs']),
        ...(p.max_flows ? [`${formatLimit(p.max_flows)} Logic Flows`] : ['Unlimited Flows']),
        ...(p.max_messages_monthly ? [`${formatLimit(p.max_messages_monthly)} Messages/month`] : ['Unlimited Messages']),
        ...(planFeatureMap[p.name] || []),
      ],
    }))
  : [
      { name: 'trial', display_name: 'Trial', key: 'trial', price: 'Free', period: '7 days', yearlyPrice: '', description: 'Get started with a free trial', highlighted: false, cta: 'Start Free Trial', ctaHref: '/signup', features: planFeatureMap.trial },
      { name: 'starter', display_name: 'Starter', key: 'starter', price: '¥2,000', period: '/month', yearlyPrice: '¥22,000/year', description: 'For small businesses getting started', highlighted: false, cta: 'Get Started', ctaHref: '/signup', features: planFeatureMap.starter },
      { name: 'pro', display_name: 'Pro', key: 'pro', price: '¥9,900', period: '/month', yearlyPrice: '¥109,900/year', description: 'Unlimited messaging and automations', highlighted: true, cta: 'Start Free Trial', ctaHref: '/signup', features: planFeatureMap.pro },
      { name: 'custom', display_name: 'Custom', key: 'custom', price: 'Contact', period: 'us', yearlyPrice: '', description: 'Tailored plan for enterprise needs', highlighted: false, cta: 'Contact Sales', ctaHref: '/contact', features: planFeatureMap.custom },
    ];

// Plans for the comparison table (exclude custom, use raw DB data)
const tablePlans = dbPlans.length > 0
  ? dbPlans.filter(p => p.name !== 'custom')
  : [];

const trialDays = dbPlans.find(p => p.name === 'trial')?.trial_days || 7;

const faqItems = [
  { question: 'How does the free trial work?', answer: 'Sign up with just your email — no credit card required. You get full access to the Trial plan features for ' + trialDays + ' days. After that, choose a paid plan or continue with limited features.' },
  { question: 'Can I switch plans at any time?', answer: 'Yes, you can upgrade or downgrade your plan at any time. When upgrading, you get immediate access to new features. When downgrading, the change takes effect at your next billing cycle.' },
  { question: 'What happens if I exceed my message limit?', answer: 'We\'ll notify you as you approach your limit. On Starter plans, messages beyond the limit are paused until the next billing cycle. Pro and Custom plans have unlimited messaging.' },
  { question: 'Do I need my own WhatsApp Business number?', answer: 'Yes, you need a WhatsApp Business API account through Meta. We guide you through the setup process, which typically takes under an hour.' },
  { question: 'Which AI providers do you support?', answer: 'We support OpenAI (GPT-4, GPT-3.5), Anthropic (Claude), z.ai, llama.cpp (local), and OpenRouter. Each customer can configure their preferred provider and model.' },
  { question: 'Is my data secure?', answer: 'All API keys and tokens are encrypted at rest using AES (Fernet). We use secure HTTPS connections for all API calls. Your data is never shared with third parties.' },
  { question: 'What payment methods do you accept?', answer: 'We accept all major credit and debit cards through Stripe. Annual billing is available with a discount equivalent to 2 months free.' },
];
---

<PageLayout
  title="Pricing"
  description="Simple, transparent pricing for WhatsApp AI agents. Start free for 14 days, then choose the plan that fits your business."
  canonicalPath="/pricing"
>
  <section class="py-20 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Simple Pricing, Powerful Features"
        subtitle="Start free, scale as you grow. No hidden fees, no surprises."
      />

      <!-- Pricing Toggle -->
      <div class="flex justify-center mb-12">
        <div class="inline-flex items-center gap-3 bg-gray-100 rounded-full px-1.5 py-1.5">
          <button id="toggle-monthly" onclick="togglePricing('monthly')" class="px-5 py-2 text-sm font-semibold rounded-full bg-wa-green text-white transition-all cursor-pointer">Monthly</button>
          <button id="toggle-yearly" onclick="togglePricing('yearly')" class="px-5 py-2 text-sm font-semibold rounded-full text-gray-600 hover:text-gray-800 transition-all cursor-pointer">Yearly <span class="text-xs text-wa-green font-normal">Save 17%</span></button>
        </div>
      </div>

      <!-- Plan Cards -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-4">
        {plans.map((plan) => (
          plan.key === 'custom' ? (
            <div class="relative rounded-2xl border border-gray-200 hover:border-gray-300 hover:shadow-md p-6 sm:p-8 flex flex-col items-center justify-center text-center transition-all duration-200">
              <h3 class="text-xl font-bold text-gray-900 mb-1">{plan.display_name}</h3>
              <p class="text-sm text-gray-500 mb-8">Need something tailored?</p>
              <a href="/contact" class="block w-full text-center px-5 py-3 rounded-lg font-semibold text-sm border-2 border-wa-green text-wa-green hover:bg-wa-green hover:text-white transition-all">
                Contact Us
              </a>
            </div>
          ) : (
          <div class:list={[
            'relative rounded-2xl border p-6 sm:p-8 flex flex-col transition-all duration-200',
            plan.highlighted
              ? 'border-wa-green shadow-lg shadow-green-500/10 scale-[1.02]'
              : 'border-gray-200 hover:border-gray-300 hover:shadow-md',
          ]}>
            {plan.highlighted && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-wa-green text-white text-xs font-semibold rounded-full">
                Most Popular
              </div>
            )}
            <div class="mb-6">
              <h3 class="text-xl font-bold text-gray-900 mb-1">{plan.display_name}</h3>
              <p class="text-sm text-gray-500">{plan.description}</p>
            </div>
            <div class="mb-6">
              <div class="flex items-baseline gap-1 monthly-price" data-monthly={plan.key}>
                <span class="text-4xl font-extrabold text-gray-900">{plan.price}</span>
                <span class="text-gray-500">{plan.period}</span>
              </div>
              {plan.yearlyPrice && (
                <div class="flex items-baseline gap-1 yearly-price hidden" data-yearly={plan.key}>
                  <span class="text-4xl font-extrabold text-gray-900">{plan.yearlyPrice.split('/')[0]}</span>
                  <span class="text-gray-500">/year</span>
                </div>
              )}
            </div>
            <ul class="space-y-3 mb-8 flex-1">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <svg class="w-5 h-5 text-wa-green shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
            <a href={plan.ctaHref} class:list={[
              'block w-full text-center px-5 py-3 rounded-lg font-semibold text-sm transition-all',
              plan.highlighted
                ? 'bg-wa-green text-white hover:bg-wa-green-dark shadow-sm'
                : 'border-2 border-wa-green text-wa-green hover:bg-wa-green hover:text-white',
            ]}>
              {plan.cta}
            </a>
          </div>
          )
        ))}
      </div>

      <!-- Feature Comparison -->
      <div class="mt-20">
        <h3 class="text-2xl font-bold text-gray-900 text-center mb-8">Compare Plans</h3>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[480px]">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="py-4 px-4 text-left text-sm font-semibold text-gray-900">Feature</th>
                {tablePlans.map((p) => (
                  <th class:list={[
                    'py-4 px-4 text-center text-sm font-semibold',
                    p.name === 'pro' ? 'text-wa-green' : 'text-gray-900',
                  ]}>{p.display_name}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {[
                { label: 'Trial Period', key: 'trial_days', format: (v: number | null) => v ? `${v} days` : '—' },
                { label: 'Q&A Pairs', key: 'max_qa_pairs' },
                { label: 'Logic Flows', key: 'max_flows' },
                { label: 'Messages / month', key: 'max_messages_monthly' },
              ].map((row) => (
                <tr class="border-b border-gray-100">
                  <td class="py-3 px-4 text-sm text-gray-600">{row.label}</td>
                  {tablePlans.map((p) => {
                    const val = (p as any)[row.key];
                    const display = row.format ? row.format(val) : (val === null || val === undefined ? 'Unlimited' : val.toLocaleString());
                    return (
                      <td class:list={[
                        'py-3 px-4 text-sm text-center',
                        val === null || val === undefined ? 'text-gray-900 font-medium' : 'text-gray-600',
                      ]}>{display}</td>
                    );
                  })}
                </tr>
              ))}
              {[
                { label: 'AI Auto-Responder', plans: ['trial', 'starter', 'pro'] },
                { label: 'Google Workspace Plugins', plans: ['pro'] },
                { label: 'Super Powers (Vision, Search)', plans: ['pro'] },
                { label: 'Document Generation', plans: ['pro'] },
              ].map((row) => (
                <tr class="border-b border-gray-100">
                  <td class="py-3 px-4 text-sm text-gray-600">{row.label}</td>
                  {tablePlans.map((p) => (
                    <td class="py-3 px-4 text-center">
                      {row.plans.includes(p.name) ? (
                        <svg class="w-5 h-5 text-wa-green mx-auto" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                      ) : (
                        <span class="text-gray-400">—</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ -->
      <div class="mt-20 max-w-3xl mx-auto">
        <h3 class="text-2xl font-bold text-gray-900 text-center mb-8">Frequently Asked Questions</h3>
        <Accordion items={faqItems} />
      </div>
    </div>
  </section>
</PageLayout>

<script is:inline>
  function togglePricing(mode) {
    var monthlyBtn = document.getElementById('toggle-monthly');
    var yearlyBtn = document.getElementById('toggle-yearly');
    if (mode === 'monthly') {
      monthlyBtn.classList.add('bg-wa-green', 'text-white');
      monthlyBtn.classList.remove('text-gray-600');
      yearlyBtn.classList.remove('bg-wa-green', 'text-white');
      yearlyBtn.classList.add('text-gray-600');
      document.querySelectorAll('.monthly-price').forEach(function(el) { el.classList.remove('hidden'); });
      document.querySelectorAll('.yearly-price').forEach(function(el) { el.classList.add('hidden'); });
    } else {
      yearlyBtn.classList.add('bg-wa-green', 'text-white');
      yearlyBtn.classList.remove('text-gray-600');
      monthlyBtn.classList.remove('bg-wa-green', 'text-white');
      monthlyBtn.classList.add('text-gray-600');
      document.querySelectorAll('.monthly-price').forEach(function(el) { el.classList.add('hidden'); });
      document.querySelectorAll('.yearly-price').forEach(function(el) { el.classList.remove('hidden'); });
    }
  }
</script>
