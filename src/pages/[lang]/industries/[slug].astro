---
import IndustryDetail from '../../../components/page/IndustryDetail.astro';
import { industries } from '../../../data/industries';
import { NON_DEFAULT_LANGS } from '../../../i18n/config';

export function getStaticPaths() {
  return NON_DEFAULT_LANGS.flatMap((lang) =>
    industries.map((i) => ({ params: { lang, slug: i.slug } }))
  );
}

const { slug } = Astro.params;
---

<IndustryDetail slug={slug!} />
