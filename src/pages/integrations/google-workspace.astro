---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/shared/SectionHeading.astro';
import CTAButton from '../../components/shared/CTAButton.astro';

const integrations = [
  {
    id: 'calendar',
    badge: 'Calendar',
    badgeColor: 'bg-blue-50 text-blue-700',
    title: 'Google Calendar',
    description: 'Let your WhatsApp agent manage appointments and scheduling in real time. Customers can book, check availability, and get reminders — all through WhatsApp.',
    useCases: [
      'Book appointments directly from WhatsApp conversations',
      'Check real-time availability across multiple calendars',
      'Send automated reminders and confirmations',
      'Create events with customer details auto-populated',
    ],
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
    iconColor: 'bg-blue-50 text-blue-600',
  },
  {
    id: 'drive',
    badge: 'File Management',
    badgeColor: 'bg-yellow-50 text-yellow-700',
    title: 'Google Drive',
    description: 'Access, manage, and share files stored in Google Drive directly from WhatsApp. Upload customer documents, retrieve files on demand, and send attachments seamlessly.',
    useCases: [
      'Send brochures, price lists, and documents from Drive',
      'Upload files received from customers to organized folders',
      'Browse and search your Drive without leaving WhatsApp',
      'Auto-organize uploads with customer-named folders',
    ],
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>`,
    iconColor: 'bg-yellow-50 text-yellow-600',
  },
  {
    id: 'docs',
    badge: 'Documents',
    badgeColor: 'bg-blue-50 text-blue-700',
    title: 'Google Docs',
    description: 'Generate native Google Docs from conversation data automatically. Turn WhatsApp interactions into professional documents — reports, proposals, invoices, and more.',
    useCases: [
      'Generate service reports from customer conversations',
      'Create proposals with customer data auto-filled',
      'Build invoices and order confirmations as Google Docs',
      'Share editable documents via WhatsApp link',
    ],
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`,
    iconColor: 'bg-blue-50 text-blue-600',
  },
  {
    id: 'sheets',
    badge: 'Spreadsheets',
    badgeColor: 'bg-green-50 text-green-700',
    title: 'Google Sheets',
    description: 'Automatically create spreadsheets and write structured data from WhatsApp conversations. Collect orders, log inquiries, and build reports without manual data entry.',
    useCases: [
      'Log customer orders directly into spreadsheets',
      'Collect survey responses and feedback in Sheets',
      'Build real-time inventory and order tracking',
      'Export conversation data for analysis and reporting',
    ],
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" /></svg>`,
    iconColor: 'bg-green-50 text-green-600',
  },
];
---

<PageLayout
  title="Google Workspace Integration"
  description="Connect WAAIChat with Google Calendar, Drive, Docs, and Sheets. Automate scheduling, file management, and document generation from WhatsApp."
  canonicalPath="/integrations/google-workspace"
>
  <!-- Hero -->
  <section class="py-20 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block px-3 py-1 text-xs font-semibold text-blue-700 bg-blue-50 rounded-full uppercase tracking-wider mb-4">Google Workspace</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 mb-4">
          Your WhatsApp Agent, Powered by Google
        </h1>
        <p class="text-lg text-gray-600 leading-relaxed">
          One OAuth connection unlocks Calendar, Drive, Docs, and Sheets. Your AI agent handles the rest — booking appointments, sending files, generating documents, and collecting data — all through WhatsApp.
        </p>
      </div>
    </div>
  </section>

  <!-- Integration Sections -->
  {integrations.map((item, index) => (
    <section class:list={['py-16', index % 2 === 0 ? 'bg-gray-50' : 'bg-white']}>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class:list={[
          'grid lg:grid-cols-2 gap-12 items-center',
          index % 2 !== 0 ? 'lg:flex-row-reverse' : '',
        ]}>
          <div class={index % 2 !== 0 ? 'lg:order-2' : ''}>
            <span class={`inline-block px-3 py-1 text-xs font-semibold ${item.badgeColor} rounded-full uppercase tracking-wider mb-3`}>
              {item.badge}
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">{item.title}</h2>
            <p class="text-lg text-gray-600 leading-relaxed mb-6">{item.description}</p>
            <ul class="space-y-3">
              {item.useCases.map((uc) => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-wa-green shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700">{uc}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class={index % 2 !== 0 ? 'lg:order-1' : ''}>
            <div class="bg-white rounded-2xl border border-gray-200 p-8 shadow-sm">
              <div class={`w-16 h-16 rounded-2xl ${item.iconColor} flex items-center justify-center mb-6`} set:html={item.icon} />
              <div class="space-y-4">
                <div class="flex items-center gap-3">
                  <div class="w-2 h-2 rounded-full bg-wa-green"></div>
                  <div class="h-2 bg-gray-100 rounded-full flex-1"></div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="w-2 h-2 rounded-full bg-wa-green"></div>
                  <div class="h-2 bg-gray-100 rounded-full w-3/4"></div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="w-2 h-2 rounded-full bg-wa-green"></div>
                  <div class="h-2 bg-gray-100 rounded-full w-5/6"></div>
                </div>
              </div>
              <div class="mt-6 p-4 bg-green-50 rounded-xl">
                <div class="flex items-center gap-2 mb-2">
                  <svg class="w-4 h-4 text-wa-green" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-sm font-semibold text-green-800">Connected</span>
                </div>
                <p class="text-xs text-green-700">Secure OAuth2 connection — WAAIChat only accesses files it creates.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- How It Works -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="How It Works"
        subtitle="Three simple steps to connect your Google Workspace."
      />
      <div class="grid sm:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-wa-green text-white text-lg font-bold flex items-center justify-center mx-auto mb-4">1</div>
          <h3 class="font-bold text-gray-900 mb-2">Connect</h3>
          <p class="text-sm text-gray-600">Click "Connect Google" in your dashboard. One-time OAuth authorization.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-wa-green text-white text-lg font-bold flex items-center justify-center mx-auto mb-4">2</div>
          <h3 class="font-bold text-gray-900 mb-2">Configure</h3>
          <p class="text-sm text-gray-600">Add Google step types to your logic flows. Map variables and set triggers.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-wa-green text-white text-lg font-bold flex items-center justify-center mx-auto mb-4">3</div>
          <h3 class="font-bold text-gray-900 mb-2">Automate</h3>
          <p class="text-sm text-gray-600">Your agent handles the rest — booking, filing, generating, and sending.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">Unlock Google Workspace on Pro</h2>
      <p class="text-lg text-gray-600 mb-8">Google integrations are available on Pro and Custom plans. Start your free trial today and explore the full power.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <CTAButton href="/signup" size="lg">Start Free Trial</CTAButton>
        <CTAButton href="/pricing" variant="secondary" size="lg">Compare Plans</CTAButton>
      </div>
    </div>
  </section>
</PageLayout>
