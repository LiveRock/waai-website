---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/shared/SectionHeading.astro';
import CTAButton from '../../components/shared/CTAButton.astro';

const googleIntegrations = [
  {
    title: 'Google Calendar',
    description: 'Automate appointment scheduling, check availability, and create events directly from WhatsApp conversations.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
    color: 'bg-blue-50 text-blue-600',
    href: '/integrations/google-workspace',
  },
  {
    title: 'Google Drive',
    description: 'Upload, manage, and share files stored in Drive. Send documents and images directly through WhatsApp.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>`,
    color: 'bg-yellow-50 text-yellow-600',
    href: '/integrations/google-workspace',
  },
  {
    title: 'Google Docs',
    description: 'Generate professional Google Docs from conversation data. Create reports, proposals, and letters on the fly.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`,
    color: 'bg-blue-50 text-blue-600',
    href: '/integrations/google-workspace',
  },
  {
    title: 'Google Sheets',
    description: 'Create spreadsheets from chat data, write structured information to sheets, and automate data collection.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" /></svg>`,
    color: 'bg-green-50 text-green-600',
    href: '/integrations/google-workspace',
  },
];

const superPowers = [
  {
    title: 'Vision AI',
    description: 'Analyze images sent by customers — identify objects, read text (OCR), extract data from charts, and describe scenes.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>`,
    color: 'bg-purple-50 text-ai-purple',
  },
  {
    title: 'Web Search',
    description: 'Search the web in real-time and deliver up-to-date answers. Your AI agent stays current with live information.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>`,
    color: 'bg-purple-50 text-ai-purple',
  },
  {
    title: 'Web Reader',
    description: 'Read and extract content from any web page. Provide customers with detailed summaries of online resources.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>`,
    color: 'bg-purple-50 text-ai-purple',
  },
  {
    title: 'Zread',
    description: 'Search and read GitHub repositories, documentation, and code. Build developer-friendly support experiences.',
    icon: `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" /></svg>`,
    color: 'bg-purple-50 text-ai-purple',
  },
];
---

<PageLayout
  title="Integrations"
  description="Connect waai with the tools you already use. Google Workspace, AI Super Powers, and more."
  canonicalPath="/integrations"
>
  <!-- Hero -->
  <section class="py-20 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Connect Your Tools, Amplify Your Agent"
        subtitle="waai integrates with the services your business relies on. From Google Workspace to AI-powered vision and search, your WhatsApp agent can do more than chat."
      />
    </div>
  </section>

  <!-- Google Workspace -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10">
        <span class="inline-block px-3 py-1 text-xs font-semibold text-blue-700 bg-blue-50 rounded-full uppercase tracking-wider mb-3">Google Workspace</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">Work Smarter with Google</h2>
        <p class="text-lg text-gray-600 mt-2 max-w-2xl">Connect your Google account once, then let your WhatsApp agent handle calendars, files, docs, and sheets automatically.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {googleIntegrations.map((item) => (
          <a href={item.href} class="group bg-white rounded-2xl border border-gray-200 p-6 hover:border-gray-300 hover:shadow-md transition-all">
            <div class={`w-12 h-12 rounded-xl ${item.color} flex items-center justify-center mb-4`} set:html={item.icon} />
            <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-wa-teal transition-colors">{item.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{item.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- AI Super Powers -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10">
        <span class="inline-block px-3 py-1 text-xs font-semibold text-ai-purple bg-purple-50 rounded-full uppercase tracking-wider mb-3">AI Super Powers</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">Give Your Agent Superpowers</h2>
        <p class="text-lg text-gray-600 mt-2 max-w-2xl">Advanced AI capabilities that go beyond text. Let your agent see images, search the web, read pages, and access code repos.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {superPowers.map((item) => (
          <div class="bg-white rounded-2xl border border-gray-200 p-6 hover:border-purple-200 hover:shadow-md transition-all">
            <div class={`w-12 h-12 rounded-xl ${item.color} flex items-center justify-center mb-4`} set:html={item.icon} />
            <h3 class="text-lg font-bold text-gray-900 mb-2">{item.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">Ready to Connect?</h2>
      <p class="text-lg text-gray-600 mb-8">Start your free trial and explore all integrations. Pro and Custom plans unlock the full power.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <CTAButton href="/signup" size="lg">Start Free Trial</CTAButton>
        <CTAButton href="/pricing" variant="secondary" size="lg">View Pricing</CTAButton>
      </div>
    </div>
  </section>
</PageLayout>
