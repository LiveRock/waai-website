---
import PageLayout from '../layouts/PageLayout.astro';
import CTAButton from '../components/shared/CTAButton.astro';
import SandLogo from '../components/404/SandLogo.astro';
---

<PageLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist. Return to the waai.me homepage."
  noindex
  noCanonical
>
  <section
    data-sand-section
    class="relative touch-pan-y select-none overflow-hidden bg-gradient-to-br from-wa-teal via-wa-teal-light to-wa-green-dark"
  >
    <!-- Dark sky pocket so the additive sand glow pops (same tone as the hero galaxy). -->
    <div
      class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_at_50%_36%,rgba(3,26,22,0.82),rgba(3,26,22,0.38)_45%,transparent_72%)]"
      aria-hidden="true"
    ></div>
    <SandLogo />
    <div class="relative z-10 mx-auto max-w-xl px-4 pb-20 text-center sm:px-6 sm:pb-28">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.35em] text-wa-green sm:text-sm">
        Error 404
      </p>
      <h1 class="mb-4 text-3xl font-extrabold text-white sm:text-4xl">This page drifted away</h1>
      <p class="mb-8 text-base leading-relaxed text-green-100/80 sm:text-lg">
        The link is broken or the page has moved. Let's get you back on track.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <CTAButton href="/" size="lg">Go to Homepage</CTAButton>
        <CTAButton href="/contact" variant="secondary" size="lg">Contact Us</CTAButton>
      </div>
      <p class="mt-8 text-sm text-green-100/50">
        Drag to turn the sand &middot; click it to poke a hole &middot; click outside to scatter it.
      </p>
    </div>
  </section>
</PageLayout>
