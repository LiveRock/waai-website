---
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeading from '../components/shared/SectionHeading.astro';

const API_URLS = [
  'http://127.0.0.1:8000/api/public/plans',
  'https://waaichat.hsi.asia/api/public/plans',
];

let dbPlans: { name: string; display_name: string; description: string | null; price_monthly: number; price_yearly: number; max_qa_pairs: number | null; max_flows: number | null; max_messages_monthly: number | null; max_respondents: number | null; max_web_pages: number | null; max_drive_sends_monthly: number | null; max_qa_translations_per_lang_monthly: number | null; max_flow_translations_per_lang_monthly: number | null; trial_days: number | null }[] = [];
for (const url of API_URLS) {
  try {
    const res = await fetch(url);
    if (res.ok) { dbPlans = await res.json(); break; }
  } catch {}
}

// Optional Onboarding Assistance one-time fees (cents), keyed by plan name.
// Sourced from waaiChat SA site_content (onboarding_service_settings);
// fallback mirrors the SA default — Starter $99, Pro $299.
const SITE_CONTENT_URLS = [
  'http://127.0.0.1:8000/api/site-content/onboarding_service_settings',
  'https://waaichat.hsi.asia/api/site-content/onboarding_service_settings',
];
const onboardingFee: Record<string, number> = { starter: 9900, pro: 29900 };
for (const url of SITE_CONTENT_URLS) {
  try {
    const res = await fetch(url);
    if (res.ok) {
      const data = await res.json();
      const cfg = typeof data.content === 'string' ? JSON.parse(data.content) : data.content;
      if (cfg?.starter?.fee_cents) onboardingFee.starter = cfg.starter.fee_cents;
      if (cfg?.pro?.fee_cents) onboardingFee.pro = cfg.pro.fee_cents;
      break;
    }
  } catch {}
}

function formatPrice(cents: number | null | undefined): string {
  if (cents === null || cents === undefined) return 'Custom';
  if (cents === 0) return 'Free';
  const dollars = cents / 100;
  return dollars % 1 === 0 ? `$${dollars.toLocaleString()}` : `$${dollars.toFixed(2)}`;
}

function formatLimit(val: number | null | undefined): string {
  if (val === null || val === undefined) return 'Unlimited';
  return val.toLocaleString();
}

// Compact feature differentiators per plan (kept short for the radio tiles).
const signupFeatureMap: Record<string, string[]> = {
  starter: ['Google Workspace plugins'],
  pro: ['Cal.com integration', 'Language translations'],
};

const trialDays = dbPlans.find(p => p.name === 'trial')?.trial_days || 7;

// Filter out custom plan from signup (they need to contact sales)
const signupPlans = dbPlans.length > 0
  ? dbPlans.filter(p => p.name !== 'custom').map(p => ({
      name: p.name,
      display_name: p.display_name,
      price: formatPrice(p.price_monthly),
      period: p.price_monthly === 0 ? `${p.trial_days || 7} days` : '/month',
      description: p.description || '',
      highlights: [
        ...(p.max_qa_pairs ? [`${formatLimit(p.max_qa_pairs)} Q&A pairs`] : ['Unlimited Q&A pairs']),
        ...(p.max_flows ? [`${formatLimit(p.max_flows)} Logic flows`] : ['Unlimited Logic flows']),
        ...(p.max_messages_monthly ? [`${formatLimit(p.max_messages_monthly)} messages/mo`] : ['Unlimited messages']),
        ...(signupFeatureMap[p.name] || []),
        ...(onboardingFee[p.name] ? ['Optional onboarding assistance'] : []),
      ],
    }))
  : [
      { name: 'trial', display_name: 'Trial', price: 'Free', period: `${trialDays} days`, description: 'Get started with a free trial', highlights: ['5 Q&A pairs', '3 Logic flows', '10 messages/mo'] },
      { name: 'starter', display_name: 'Starter', price: '$20', period: '/month', description: 'For small businesses getting started with AI chat', highlights: ['50 Q&A pairs', '10 Logic flows', '1,500 messages/mo', 'Google Workspace plugins', 'Optional onboarding assistance'] },
      { name: 'pro', display_name: 'Pro', price: '$99', period: '/month', description: 'Optimised messaging and automations for growing businesses', highlights: ['500 Q&A pairs', '200 Logic flows', '5,000 messages/mo', 'Cal.com integration', 'Language translations', 'Optional onboarding assistance'] },
    ];
---

<PageLayout
  title="Sign Up"
  description={`Create your waai account. Choose a plan and set up your WhatsApp AI agent in minutes.`}
  canonicalPath="/signup"
>
  <section class="py-16 sm:py-20 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Create Your Account"
        subtitle="Choose a plan, then fill in your details. No credit card required."
      />

      <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 sm:p-10">
        <form id="signup-form" class="space-y-5">

          <!-- Plan Selection (first) -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-3">Choose Your Plan</label>
            <div class="grid sm:grid-cols-3 gap-3">
              {signupPlans.map((plan, i) => (
                <label class="relative cursor-pointer">
                  <input type="radio" name="plan_name" value={plan.name} class="peer sr-only" checked={i === 0} />
                  <div class="rounded-xl border-2 border-gray-200 p-4 peer-checked:border-wa-green peer-checked:bg-green-50 transition-all h-full">
                    <div class="flex items-center justify-between mb-2">
                      <span class="text-sm font-bold text-gray-900">{plan.display_name}</span>
                      <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${plan.name === 'pro' ? 'text-ai-purple bg-purple-100' : plan.price === 'Free' ? 'text-wa-green bg-green-100' : 'text-gray-700 bg-gray-100'}`}>
                        {plan.price}
                      </span>
                    </div>
                    <p class="text-xs text-gray-400 mb-2">{plan.period}</p>
                    <ul class="text-xs text-gray-500 space-y-0.5">
                      {plan.highlights.map(h => (
                        <li>{h}</li>
                      ))}
                    </ul>
                  </div>
                </label>
              ))}
            </div>
          </div>

          <!-- Optional Onboarding Assistance note -->
          <p class="text-xs text-gray-500 mt-3">
            Prefer hands-on setup? Add <span class="font-medium text-gray-700">Optional Onboarding Assistance</span> after signup — we configure your bot for you ({formatPrice(onboardingFee.starter)} Starter / {formatPrice(onboardingFee.pro)} Pro, one-time). <a href="/pricing" class="text-wa-teal hover:underline">See pricing</a>.
          </p>

          <hr class="border-gray-100" />

          <!-- Company Name -->
          <div>
            <label for="company_name" class="block text-sm font-medium text-gray-700 mb-1.5">Company Name</label>
            <input
              type="text"
              id="company_name"
              name="company_name"
              required
              placeholder="Your company or business name"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-wa-green focus:border-transparent transition"
            />
          </div>

          <!-- Contact Person -->
          <div>
            <label for="contact_person" class="block text-sm font-medium text-gray-700 mb-1.5">Contact Person</label>
            <input
              type="text"
              id="contact_person"
              name="contact_person"
              required
              placeholder="Full name of primary contact"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-wa-green focus:border-transparent transition"
            />
          </div>

          <!-- Email & Phone Row -->
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-1.5">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="you@company.com"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-wa-green focus:border-transparent transition"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-gray-700 mb-1.5">Phone <span class="text-gray-400 font-normal">(optional)</span></label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="+1 234 567 8900"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-wa-green focus:border-transparent transition"
              />
            </div>
          </div>

          <!-- Password Row -->
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="password" class="block text-sm font-medium text-gray-700 mb-1.5">Password</label>
              <input
                type="password"
                id="password"
                name="password"
                required
                minlength="6"
                placeholder="Minimum 6 characters"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-wa-green focus:border-transparent transition"
              />
            </div>
            <div>
              <label for="confirm_password" class="block text-sm font-medium text-gray-700 mb-1.5">Confirm Password</label>
              <input
                type="password"
                id="confirm_password"
                name="confirm_password"
                required
                minlength="6"
                placeholder="Repeat your password"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-wa-green focus:border-transparent transition"
              />
            </div>
          </div>

          <!-- Validation Message -->
          <div id="form-message" class="hidden text-sm font-medium rounded-lg px-4 py-3"></div>

          <!-- Submit -->
          <button
            type="submit"
            id="submit-btn"
            class="w-full px-6 py-3 bg-wa-green text-white font-semibold rounded-lg hover:bg-wa-green-dark transition-all shadow-sm hover:shadow-md disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Create Account
          </button>

          <p class="text-center text-sm text-gray-500">
            By signing up, you agree to our
            <a href="/terms" class="text-wa-teal hover:underline">Terms of Service</a>
            and
            <a href="/privacy" class="text-wa-teal hover:underline">Privacy Policy</a>.
          </p>
        </form>

        <!-- Verification code step (shown after a successful signup) -->
        <div id="verify-section" class="hidden space-y-5">
          <div class="text-center">
            <h2 class="text-xl font-bold text-gray-900">Verify your email</h2>
            <p class="text-sm text-gray-500 mt-1">We sent a 6-digit code to <span id="verify-email" class="font-medium text-gray-700 break-all"></span></p>
          </div>

          <input
            id="code-input"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            maxlength="6"
            placeholder="······"
            class="w-full px-4 py-3 text-center tracking-[0.5em] font-mono text-2xl rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-wa-green focus:border-transparent transition"
          />

          <div id="verify-message" class="hidden text-sm font-medium rounded-lg px-4 py-3"></div>

          <button
            type="button"
            id="verify-btn"
            class="w-full px-6 py-3 bg-wa-green text-white font-semibold rounded-lg hover:bg-wa-green-dark transition-all shadow-sm hover:shadow-md disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Verify &amp; continue
          </button>

          <div class="text-center text-sm">
            <span id="resend-area"></span>
          </div>

          <p class="text-center text-xs text-gray-400">
            Wrong email? <a href="/signup" class="text-wa-teal hover:underline font-medium">Start over</a>
          </p>
        </div>
      </div>

      <p class="text-center text-sm text-gray-500 mt-6">
        Already have an account?
        <a href="https://waaichat.hsi.asia/login" class="text-wa-green font-semibold hover:underline">Sign in</a>
      </p>
    </div>
  </section>
</PageLayout>

<script>
  const form = document.getElementById('signup-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const formMessage = document.getElementById('form-message') as HTMLDivElement;

  function showMessage(text: string, type: 'success' | 'error') {
    formMessage.textContent = text;
    formMessage.className = type === 'success'
      ? 'text-sm font-medium rounded-lg px-4 py-3 bg-green-50 text-green-800'
      : 'text-sm font-medium rounded-lg px-4 py-3 bg-red-50 text-red-800';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const password = (document.getElementById('password') as HTMLInputElement).value;
    const confirmPassword = (document.getElementById('confirm_password') as HTMLInputElement).value;

    if (password.length < 6) {
      showMessage('Password must be at least 6 characters.', 'error');
      return;
    }
    if (password !== confirmPassword) {
      showMessage('Passwords do not match.', 'error');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Creating account...';
    formMessage.className = 'hidden text-sm font-medium rounded-lg px-4 py-3';

    const data = {
      company_name: (document.getElementById('company_name') as HTMLInputElement).value,
      contact_person: (document.getElementById('contact_person') as HTMLInputElement).value,
      email: (document.getElementById('email') as HTMLInputElement).value,
      phone: (document.getElementById('phone') as HTMLInputElement).value || undefined,
      password: password,
      plan_name: (document.querySelector('input[name="plan_name"]:checked') as HTMLInputElement).value,
    };

    try {
      const res = await fetch('https://waaichat.hsi.asia/api/auth/signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        enterVerifyStep(data.email);
      } else {
        const body = await res.json().catch(() => ({}));
        const detail = body.detail;
        if (typeof detail === 'string') {
          showMessage(detail, 'error');
        } else if (Array.isArray(detail)) {
          showMessage(detail.map((d: any) => d.msg).join('. '), 'error');
        } else {
          showMessage('Something went wrong. Please try again.', 'error');
        }
      }
    } catch {
      showMessage('Network error. Please check your connection and try again.', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Create Account';
    }
  });

  // ── Verification code step (shown after a successful signup) ──
  // waai.me and the app are different origins, so we can't share localStorage.
  // We verify the code here, then hand the auto-login tokens to the app via a
  // URL fragment on /auth/callback (which stores them + scrubs the fragment).
  const API = 'https://waaichat.hsi.asia/api';
  const verifySection = document.getElementById('verify-section') as HTMLDivElement | null;
  const verifyBtn = document.getElementById('verify-btn') as HTMLButtonElement | null;
  const codeInput = document.getElementById('code-input') as HTMLInputElement | null;
  const verifyMessage = document.getElementById('verify-message') as HTMLDivElement | null;
  const verifyEmailEl = document.getElementById('verify-email') as HTMLElement | null;
  const resendArea = document.getElementById('resend-area') as HTMLElement | null;
  let verifyEmail = '';
  let resendSeconds = 0;
  let resendTimer: ReturnType<typeof setInterval> | undefined;

  function showVerifyMessage(text: string, type: 'success' | 'error') {
    if (!verifyMessage) return;
    verifyMessage.textContent = text;
    verifyMessage.className = type === 'success'
      ? 'text-sm font-medium rounded-lg px-4 py-3 bg-green-50 text-green-800'
      : 'text-sm font-medium rounded-lg px-4 py-3 bg-red-50 text-red-800';
  }

  function renderResend() {
    if (!resendArea) return;
    if (resendSeconds > 0) {
      resendArea.innerHTML = `<span class="text-gray-400">Resend code in ${resendSeconds}s</span>`;
    } else {
      resendArea.innerHTML = `<button type="button" id="resend-btn" class="text-wa-green font-semibold hover:underline">Resend code</button>`;
      document.getElementById('resend-btn')?.addEventListener('click', doResend);
    }
  }

  function startResendCountdown() {
    resendSeconds = 60;
    renderResend();
    if (resendTimer) clearInterval(resendTimer);
    resendTimer = setInterval(() => {
      resendSeconds -= 1;
      if (resendSeconds <= 0) {
        resendSeconds = 0;
        if (resendTimer) clearInterval(resendTimer);
      }
      renderResend();
    }, 1000);
  }

  async function doResend() {
    if (!verifyEmail) return;
    try {
      const res = await fetch(`${API}/auth/resend-verification`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: verifyEmail }),
      });
      if (res.status === 429) {
        showVerifyMessage('Please wait a moment before requesting a new code.', 'error');
        return;
      }
      startResendCountdown();
      showVerifyMessage('New code sent. Check your inbox.', 'success');
    } catch {
      showVerifyMessage('Network error. Please try again.', 'error');
    }
  }

  async function submitVerify() {
    if (!codeInput) return;
    const code = codeInput.value.trim();
    if (code.length !== 6) return;
    if (verifyBtn) { verifyBtn.disabled = true; verifyBtn.textContent = 'Verifying…'; }
    if (verifyMessage) verifyMessage.className = 'hidden text-sm font-medium rounded-lg px-4 py-3';
    try {
      const res = await fetch(`${API}/auth/verify-email`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: verifyEmail, code }),
      });
      if (res.ok) {
        const data = await res.json();
        const params = new URLSearchParams();
        if (data.access_token) params.set('access_token', data.access_token);
        if (data.refresh_token) params.set('refresh_token', data.refresh_token);
        window.location.href = 'https://waaichat.hsi.asia/auth/callback#' + params.toString();
        return;
      }
      const body = await res.json().catch(() => ({}));
      const detail = typeof body.detail === 'string' ? body.detail : 'Verification failed. Please try again.';
      showVerifyMessage(detail, 'error');
      codeInput.value = '';
      codeInput.focus();
    } catch {
      showVerifyMessage('Network error. Please try again.', 'error');
    } finally {
      if (verifyBtn) { verifyBtn.disabled = false; verifyBtn.textContent = 'Verify & continue'; }
    }
  }

  function enterVerifyStep(email: string) {
    verifyEmail = (email || '').trim();
    form?.classList.add('hidden');
    verifySection?.classList.remove('hidden');
    if (verifyEmailEl) verifyEmailEl.textContent = verifyEmail;
    codeInput?.focus();
    startResendCountdown();
  }

  verifyBtn?.addEventListener('click', submitVerify);
  codeInput?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter') { e.preventDefault(); submitVerify(); }
  });
  codeInput?.addEventListener('input', () => {
    if (codeInput) codeInput.value = codeInput.value.replace(/\D/g, '').slice(0, 6);
  });
</script>
