---
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeading from '../components/shared/SectionHeading.astro';
import CTAButton from '../components/shared/CTAButton.astro';
---

<PageLayout
  title="Sign Up"
  description="Create your WAAIChat account. Start your 14-day free trial — no credit card required."
  canonicalPath="/signup"
>
  <section class="py-16 sm:py-20 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Create Your Account"
        subtitle="Start your 14-day free trial. No credit card required. Set up your WhatsApp AI agent in minutes."
      />

      <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 sm:p-10">
        <form id="signup-form" class="space-y-5">
          <!-- Company Name -->
          <div>
            <label for="company_name" class="block text-sm font-medium text-gray-700 mb-1.5">Company Name</label>
            <input
              type="text"
              id="company_name"
              name="company_name"
              required
              placeholder="Your company or business name"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-wa-green focus:border-transparent transition"
            />
          </div>

          <!-- Contact Person -->
          <div>
            <label for="contact_person" class="block text-sm font-medium text-gray-700 mb-1.5">Contact Person</label>
            <input
              type="text"
              id="contact_person"
              name="contact_person"
              required
              placeholder="Full name of primary contact"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-wa-green focus:border-transparent transition"
            />
          </div>

          <!-- Email & Phone Row -->
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-1.5">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="you@company.com"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-wa-green focus:border-transparent transition"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-gray-700 mb-1.5">Phone <span class="text-gray-400 font-normal">(optional)</span></label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="+1 234 567 8900"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-wa-green focus:border-transparent transition"
              />
            </div>
          </div>

          <!-- Password Row -->
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="password" class="block text-sm font-medium text-gray-700 mb-1.5">Password</label>
              <input
                type="password"
                id="password"
                name="password"
                required
                minlength="6"
                placeholder="Minimum 6 characters"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-wa-green focus:border-transparent transition"
              />
            </div>
            <div>
              <label for="confirm_password" class="block text-sm font-medium text-gray-700 mb-1.5">Confirm Password</label>
              <input
                type="password"
                id="confirm_password"
                name="confirm_password"
                required
                minlength="6"
                placeholder="Repeat your password"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-wa-green focus:border-transparent transition"
              />
            </div>
          </div>

          <!-- Plan Selection -->
          <div class="pt-2">
            <label class="block text-sm font-medium text-gray-700 mb-3">Choose Your Plan</label>
            <div class="grid sm:grid-cols-3 gap-3">
              <label class="relative cursor-pointer">
                <input type="radio" name="plan" value="trial" class="peer sr-only" checked />
                <div class="rounded-xl border-2 border-gray-200 p-4 peer-checked:border-wa-green peer-checked:bg-green-50 transition-all">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-sm font-bold text-gray-900">Trial</span>
                    <span class="text-xs font-semibold text-wa-green bg-green-100 px-2 py-0.5 rounded-full">Free</span>
                  </div>
                  <p class="text-xs text-gray-500">14 days, 500 messages. Try before you commit.</p>
                </div>
              </label>

              <label class="relative cursor-pointer">
                <input type="radio" name="plan" value="starter" class="peer sr-only" />
                <div class="rounded-xl border-2 border-gray-200 p-4 peer-checked:border-wa-green peer-checked:bg-green-50 transition-all">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-sm font-bold text-gray-900">Starter</span>
                    <span class="text-xs font-semibold text-gray-700 bg-gray-100 px-2 py-0.5 rounded-full">$29/mo</span>
                  </div>
                  <p class="text-xs text-gray-500">5,000 messages, 200 Q&A pairs, logic flows.</p>
                </div>
              </label>

              <label class="relative cursor-pointer">
                <input type="radio" name="plan" value="pro" class="peer sr-only" />
                <div class="rounded-xl border-2 border-gray-200 p-4 peer-checked:border-wa-green peer-checked:bg-green-50 transition-all">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-sm font-bold text-gray-900">Pro</span>
                    <span class="text-xs font-semibold text-ai-purple bg-purple-100 px-2 py-0.5 rounded-full">$99/mo</span>
                  </div>
                  <p class="text-xs text-gray-500">Unlimited. Google plugins, Super Powers, docs.</p>
                </div>
              </label>
            </div>
          </div>

          <!-- Validation Message -->
          <div id="form-message" class="hidden text-sm font-medium rounded-lg px-4 py-3"></div>

          <!-- Submit -->
          <button
            type="submit"
            id="submit-btn"
            class="w-full px-6 py-3 bg-wa-green text-white font-semibold rounded-lg hover:bg-wa-green-dark transition-all shadow-sm hover:shadow-md disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Create Account
          </button>

          <p class="text-center text-sm text-gray-500">
            By signing up, you agree to our
            <a href="/terms" class="text-wa-teal hover:underline">Terms of Service</a>
            and
            <a href="/privacy" class="text-wa-teal hover:underline">Privacy Policy</a>.
          </p>
        </form>
      </div>

      <p class="text-center text-sm text-gray-500 mt-6">
        Already have an account?
        <a href="https://waaichat.hsi.asia/login" class="text-wa-green font-semibold hover:underline">Sign in</a>
      </p>
    </div>
  </section>
</PageLayout>

<script>
  const form = document.getElementById('signup-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const formMessage = document.getElementById('form-message') as HTMLDivElement;

  function showMessage(text: string, type: 'success' | 'error') {
    formMessage.textContent = text;
    formMessage.className = type === 'success'
      ? 'text-sm font-medium rounded-lg px-4 py-3 bg-green-50 text-green-800'
      : 'text-sm font-medium rounded-lg px-4 py-3 bg-red-50 text-red-800';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const password = (document.getElementById('password') as HTMLInputElement).value;
    const confirmPassword = (document.getElementById('confirm_password') as HTMLInputElement).value;

    // Client-side validation
    if (password.length < 6) {
      showMessage('Password must be at least 6 characters.', 'error');
      return;
    }
    if (password !== confirmPassword) {
      showMessage('Passwords do not match.', 'error');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Creating account...';
    formMessage.className = 'hidden text-sm font-medium rounded-lg px-4 py-3';

    const data = {
      company_name: (document.getElementById('company_name') as HTMLInputElement).value,
      contact_person: (document.getElementById('contact_person') as HTMLInputElement).value,
      email: (document.getElementById('email') as HTMLInputElement).value,
      phone: (document.getElementById('phone') as HTMLInputElement).value || undefined,
      password: password,
      plan: (document.querySelector('input[name="plan"]:checked') as HTMLInputElement).value,
    };

    try {
      const res = await fetch('https://waaichat.hsi.asia/api/auth/signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        showMessage('Account created! Redirecting to login...', 'success');
        setTimeout(() => {
          window.location.href = 'https://waaichat.hsi.asia/login';
        }, 1500);
      } else {
        const body = await res.json().catch(() => ({}));
        const detail = body.detail;
        if (typeof detail === 'string') {
          showMessage(detail, 'error');
        } else if (Array.isArray(detail)) {
          showMessage(detail.map((d: any) => d.msg).join('. '), 'error');
        } else {
          showMessage('Something went wrong. Please try again.', 'error');
        }
      }
    } catch {
      showMessage('Network error. Please check your connection and try again.', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Create Account';
    }
  });
</script>
