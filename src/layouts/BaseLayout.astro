---
import '../styles/global.css';
import { getLangFromUrl, getAlternates, stripLang } from '../i18n/utils';
import { LOCALES, type LocaleFont } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = '/images/og-default.png',
  ogType = 'website',
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const locale = LOCALES[lang];
const canonicalUrl = `https://waai.me${canonicalPath}`;
const alternates = getAlternates(Astro.url.pathname);
const xDefaultUrl = `https://waai.me${stripLang(Astro.url.pathname)}`;

// Load an extra webfont only when the locale's script needs it.
const FONT_HREFS: Record<LocaleFont, string> = {
  'noto-sc': 'https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&display=swap',
  'noto-tamil': 'https://fonts.googleapis.com/css2?family=Noto+Sans+Tamil:wght@400;500;600;700&display=swap',
  'noto-thai': 'https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap',
  'noto-kr': 'https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700&display=swap',
  'noto-jp': 'https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&display=swap',
};
const fontHref = locale.font ? FONT_HREFS[locale.font] : null;
---

<!DOCTYPE html>
<html lang={locale.htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | waai.me</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  {alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={`https://waai.me${ogImage}`} />
  <meta property="og:site_name" content="waai.me" />
  <meta property="og:locale" content={locale.htmlLang.replace('-', '_')} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`https://waai.me${ogImage}`} />

  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  {fontHref && <link href={fontHref} rel="stylesheet" />}
</head>
<body class="font-sans text-gray-900 bg-white antialiased">
  <slot />

  <!-- Floating WhatsApp button — same destination as the header "WhatsApp" menu item (src/data/navigation.ts) -->
  <a
    href="https://api.whatsapp.com/send?phone=6581773301&text=Hi%20Hotsource!%20I%27d%20like%20to%20know%20more"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat with us on WhatsApp"
    class="fixed bottom-5 right-5 z-50 flex items-center justify-center w-14 h-14 rounded-full bg-wa-green shadow-lg transition-all duration-200 hover:bg-wa-green-dark hover:scale-110"
  >
    <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.148-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
      />
    </svg>
  </a>
</body>
</html>
